# This is a simple Lego brick OBJ file

mtllib lego.mtl

# Vertices
v 0.0 0.0 0.0
v 1.0 0.0 0.0
v 1.0 1.0 0.0
v 0.0 1.0 0.0

# Vertex normals (not necessary for this simple example)
vn 0.0 0.0 1.0

# Texture coordinates (not necessary for this simple example)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Faces (using vertices, normals, and texture coordinates)
usemtl LegoMaterial

f 1/1 2/2 3/3
f 1/1 3/3 4/4
