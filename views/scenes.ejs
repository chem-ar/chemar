<%- include('partials/header') %>

<!-- ADMIN NAVBAR CHECK -->
<% if (isOwner) { %>
    <%- include('partials/navbarowner') %>
<% } else if (isInstructor || isAdmin) { %>
    <%- include('partials/navbarAdmin') %>
<% } else { %>
    <%- include('partials/navbar') %>
<% } %>

<script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

<div class="container mb-4 main-background-color">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white">
            <h1 class="display-4 fw-bold">Scenes Catalog</h1>

            <% if (isOwner || isAdmin || isInstructor) { %>
                <%- include('partials/addScene') %>
            <% } %>

            <table id="sceneTable" class="table table-striped text-white" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Owner</th>
                        <th>Visibility</th>
                        <th class="options-column-scenes">Options</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let scene of list) { %>
                        <% let filename = scene.filename; %>
                        <% let isVisibleToUser = scene.studentAccessible || scene.sceneOwner === email || isOwner; %>
                        <% let canEdit = isOwner || scene.sceneOwner === email; %>
                        <% if (isVisibleToUser) { %>
                        <tr>
                            <td>
                                <a class="text-white names-in-scenes" href="/sceneViewer/<%= filename.slice(0, -5) %>">
                                    <%= scene.name %>
                                </a>
                            </td>
                            <td class="text-white desc-in-scenes"><%= scene.desc %></td>
                            <td class="text-white"><%= scene.sceneOwner %></td>
                            <td class="text-white">
                                <% if (scene.studentAccessible) { %>
                                    Public
                                <% } else { %>
                                    Private (You)
                                <% } %>
                            </td>
                            <td class="options-column-scenes">
                                <div class="d-grid gap-2">
                                    <button type="button" class="view btn" onclick="window.location.href='/sceneViewer/<%= filename.slice(0, -5) %>'" style="background-color: #6c757d; color: black;">
                                        View AR
                                    </button>
                                    <button type="button" class="share btn" style="background-color: #00BFE3; color: black;" data-bs-toggle="modal" data-bs-target="#shareModal" data-scene="<%= filename.slice(0, -5) %>">
                                        Share
                                    </button>
            
                                    <% if (canEdit) { %>
                                        <button onclick="goToPage('/sceneEditor/<%= filename %>')" type="button" class="btn" style="background-color: #FFB300; color: black;">
                                            Edit
                                        </button>
            
                                        <button type="button" class="btn deleteSceneBtn" style="background-color: #CC0000; color: white;" data-bs-toggle="modal" data-bs-target="#deleteModal" data-scene="<%= filename.slice(0, -5) %>">
                                            Delete
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                        <% } %>
                    <% } %>
                </tbody>
            </table>
            
        </div>
    </div>
</div>

<!-- DataTables Scripts -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

<script>
    $(document).ready(function () {
        $('#sceneTable').DataTable({
            columnDefs: [{ orderable: false, targets: [3] }] // 'Options' column is now index 3
        });
    });

    function goToPage(url) {
        window.location.href = url;
    }

    $('.share').on('click', function () {
        const scene = $(this).data('scene');
        const qrcode = new QRCode(document.getElementById("qrcode"));
        qrcode.makeCode(`${window.location.origin}/sceneViewer/${scene}`);
    });

    $('.deleteSceneBtn').on('click', function () {
        const sceneName = $(this).data('scene');
        $('#deleteModal .modal-body').text(`Are you sure you want to delete "${sceneName}"?`).attr('data-scene-to-delete', sceneName);
    });

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.deleteSceneBtn').forEach(button => {
            button.addEventListener('click', function () {
                const sceneName = this.dataset.scene;
                const modalBody = document.querySelector('#deleteModal .modal-body');
                modalBody.textContent = `Are you sure you want to delete "${sceneName}"?`;
                modalBody.setAttribute('data-scene-to-delete', sceneName);
            });
        });

        const confirmBtn = document.getElementById('confirmDeleteBtn');
        confirmBtn.addEventListener('click', function (e) {
            e.preventDefault();
            const sceneName = document.querySelector('#deleteModal .modal-body').getAttribute('data-scene-to-delete');
            fetch(`/scenes/deleteScene/${sceneName}`, { method: 'POST' })
                .then(response => {
                    if (response.ok) {
                        location.reload();
                    } else {
                        toastr.error('Failed to delete scene');
                    }
                })
                .catch(() => toastr.error('Server error'));
        });
    });
</script>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h5 class="modal-title text-white">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-white"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Share Modal -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-body text-center">
                <div id="qrcode" class="bg-white py-4"></div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
