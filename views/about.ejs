<body>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="/js/convertMolFileToJSON.js"></script>

  <canvas class="webgl"></canvas>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const canvas = document.querySelector("canvas.webgl");
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    camera.position.z = 5;

    const ambientLight = new THREE.AmbientLight(0x404040, 3);
    const directionalLight = new THREE.DirectionalLight(0xffffff, 2);
    directionalLight.position.set(10, 10, 10).normalize();
    scene.add(ambientLight, directionalLight);

    const sphereRadiusRatio = 0.8; // Smaller ratio to reduce sphere sizes
    const moleculeGroup = new THREE.Group();
    moleculeGroup.scale.set(0.5, 0.5, 0.5); // Slightly smaller than previous
    scene.add(moleculeGroup);

    const moleculeGeometries = {
        C: new THREE.SphereGeometry(0.5 * sphereRadiusRatio, 32, 32),
        H: new THREE.SphereGeometry(0.2 * sphereRadiusRatio, 32, 32),
        O: new THREE.SphereGeometry(0.3 * sphereRadiusRatio, 32, 32),
        N: new THREE.SphereGeometry(0.4 * sphereRadiusRatio, 32, 32),
        S: new THREE.SphereGeometry(0.5 * sphereRadiusRatio, 32, 32),
        P: new THREE.SphereGeometry(0.6 * sphereRadiusRatio, 32, 32),
        F: new THREE.SphereGeometry(0.3 * sphereRadiusRatio, 32, 32),
        Cl: new THREE.SphereGeometry(0.4 * sphereRadiusRatio, 32, 32),
        Br: new THREE.SphereGeometry(0.4 * sphereRadiusRatio, 32, 32),
        I: new THREE.SphereGeometry(0.5 * sphereRadiusRatio, 32, 32),
    };

    const moleculeMaterials = {
        C: new THREE.MeshPhongMaterial({ color: 0x444444 }), // Less vibrant
        H: new THREE.MeshPhongMaterial({ color: 0xcccccc }), // Softer white
        O: new THREE.MeshPhongMaterial({ color: 0xcc6666 }), // Softer red
        N: new THREE.MeshPhongMaterial({ color: 0x6666cc }), // Softer blue
        S: new THREE.MeshPhongMaterial({ color: 0xcccc66 }), // Softer yellow
        P: new THREE.MeshPhongMaterial({ color: 0xcc66cc }), // Softer pink
        F: new THREE.MeshPhongMaterial({ color: 0x66cc66 }), // Softer green
        Cl: new THREE.MeshPhongMaterial({ color: 0x66cc66 }), // Same soft green
        Br: new THREE.MeshPhongMaterial({ color: 0x66cc66 }), // Same soft green
        I: new THREE.MeshPhongMaterial({ color: 0x66cc66 }), // Same soft green
    };

    const cylinderMaterial = new THREE.MeshBasicMaterial({ color: 0x999999 }); // Softer bond color

    function addAtoms(molObject, center) {
        molObject.atoms.forEach(atom => {
            const atomGeometry = moleculeGeometries[atom.type];
            const atomMaterial = moleculeMaterials[atom.type];
            if (atomGeometry && atomMaterial) {
                const atomMesh = new THREE.Mesh(atomGeometry, atomMaterial);
                atomMesh.position.set(
                    atom.position.x - center.x,
                    atom.position.y - center.y,
                    atom.position.z - center.z
                );
                moleculeGroup.add(atomMesh);
            }
        });
    }

    function addBonds(molObject, center) {
        molObject.bonds.forEach(bond => {
            const start = molObject.atoms[bond[0] - 1].position;
            const end = molObject.atoms[bond[1] - 1].position;

            const startVec = new THREE.Vector3(
                start.x - center.x,
                start.y - center.y,
                start.z - center.z
            );
            const endVec = new THREE.Vector3(
                end.x - center.x,
                end.y - center.y,
                end.z - center.z
            );

            const distance = startVec.distanceTo(endVec);
            const cylinderRadius = bond[2] === 1 ? 0.03 : 0.1;

            const bondGeometry = new THREE.CylinderGeometry(cylinderRadius, cylinderRadius, distance, 8);
            bondGeometry.translate(0, distance / 2, 0);
            bondGeometry.rotateX(Math.PI / 2);

            const bondMesh = new THREE.Mesh(bondGeometry, cylinderMaterial);
            bondMesh.position.copy(startVec);
            bondMesh.lookAt(endVec);

            moleculeGroup.add(bondMesh);
        });
    }

    function drawMolecule(molFile) {
        while (moleculeGroup.children.length > 0) {
            moleculeGroup.remove(moleculeGroup.children[0]);
        }

        const molObject = molFileToJSON(molFile);
        const moleculeCenter = new THREE.Vector3(
            (Math.min(...molObject.atoms.map(atom => atom.position.x)) + Math.max(...molObject.atoms.map(atom => atom.position.x))) / 2,
            (Math.min(...molObject.atoms.map(atom => atom.position.y)) + Math.max(...molObject.atoms.map(atom => atom.position.y))) / 2,
            (Math.min(...molObject.atoms.map(atom => atom.position.z)) + Math.max(...molObject.atoms.map(atom => atom.position.z))) / 2
        );

        addAtoms(molObject, moleculeCenter);
        addBonds(molObject, moleculeCenter);
    }

    function getMolecule(CSID) {
        fetch(`/frontPageMolecule/${CSID}.mol`)
            .then(response => response.text())
            .then(molFile => drawMolecule(molFile))
            .catch(error => console.error("Error loading molecule:", error));
    }

    getMolecule("5280795");

    function animate() {
        requestAnimationFrame(animate);
        moleculeGroup.rotation.y += 0.002;
        moleculeGroup.rotation.x += 0.0003;
        renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
        renderer.setSize(window.innerWidth, window.innerHeight);
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
    });

    window.addEventListener("scroll", () => {
        const scrollY = window.scrollY;
        const scaleValue = 0.5 + (scrollY / 500) * 0.5; // Adjust scaling factor
        moleculeGroup.scale.set(scaleValue, scaleValue, scaleValue);
    });
});
</script>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    const emailButton = document.querySelector(".btn-info");

    emailButton.addEventListener("click", () => {
        emailButton.classList.add("pop-out");
        setTimeout(() => emailButton.classList.remove("pop-out"), 500); // Keep the pop-out effect slightly longer
    });
});
  </script>

<div class="content-wrapper">
    <div class="about-page p-3 mb-2 text-white main-background-color text-center">
      <h2 class="display-6 fw-bold fade-in-section">About ChemAR</h2>
      <p class="fade-in-section">
        The Chemical Augmented Reality Project is an innovative web application
        designed to provide users with an immersive experience by enabling the
        visualization of 3D molecular models through Augmented Reality (AR).
        Leveraging the AR.js library, this application adeptly detects markers
        and seamlessly presents captivating 3D models directly within the user's
        web browser. These dynamic models are generated from .mol files,
        meticulously designed to emulate the classic "ball and stick" molecular
        representation, ensuring both accuracy and familiarity for users
        engaging with chemical structures.
      </p>

      <h2 class="display-6 fw-bold fade-in-section">Team Mission</h2>
      <div class="row fade-in-section">
        <div class="col-sm">
          <p>
            The Chemical Augmented Reality Project has been established to
            enrich the academic journey of Dalhousie students. Our mission is to
            provide an unparalleled immersive experience by utilizing the ability
            of Augmented Reality (AR) to visualize intricate 3D molecular
            models. At the heart of the web application lies the AR.js library,
            a development technology that detects markers, enabling a
            captivating list of 3D models directly accessible through your web
            browser. Through our passion for science and technology, we
            introduce dynamic molecular models, generated from .mol files. The
            classic "ball and stick" representation is emulated, displaying both
            accuracy and familiarity for users engaging with complex chemical
            structures.
          </p>
        </div>
      </div>

      <h2 class="display-6 fw-bold fade-in-section">Project Features</h2>

      <h4 class="fade-in-section">Visualizations and 3D Models</h4>
      <p class="fade-in-section">
        The Chemical Augmented Reality Project utilizes both the PubChem and
        ChemSpider Representational State Transfer - Application Programming
        Interface(s) (REST-APIs); which have access to an extensive
        repository of chemical data. These provide the .mol molecule files
        that display the structure of the molecular elements and compounds
        that are present on the web application.
      </p>
      <p class="fade-in-section">
        Read more about the PubChem API
        <a class="about-links" href="https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6030920/" target="_blank">here</a>.
      </p>
      <h4 class="fade-in-section">Molecules</h4>
      <p class="fade-in-section">
        The Molecule page contains the molecule catalog which feature the
        deployed chemical elements and compounds, organized for user
        convenience. Additionally, users may further share or access these
        to retrieve specific molecular visual data on alternative devices
        via the Quick Response (QR) Code.
      </p>
      <p class="fade-in-section">
        Read more about the molecule catalog
        <a class="about-links" href="https://chem-space.com/" target="_blank">here</a>.
      </p>

      <h4 class="fade-in-section">Scenes</h4>
