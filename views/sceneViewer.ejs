    <script type= "module">
        if(/iPhone|iPad/.test(navigator.userAgent)){
            const webxrViewerScheme = "ios-webxr-viewer://"
            const xrViewerApp = "https://apps.apple.com/ca/app/webxr-viewer/id1295998056";
            const webViewerUrl = "ios-webxr-viewer://load?url=" + window.location.href;
            const isAppInstalled = window.navigator.registerProtocolHandler(webxrViewerScheme, window.location.href, "webxr")  
            if (isAppInstalled == false){
                const modal = document.createElement("div");
                modal.innerHTML = `
                    <div>
                    <h2>Download WebXR Viewer to Use This IOS</h2>
                    <p>Would you like to download our app from the App Store?</p>
                    <button id="downloadButton">Download</button>
                    <button id="cancelButton">Cancel</button>
                    </div>
                    `;
                modal.id = "appDownloadModal";
                modal.style.display = "block";
                modal.style.position = "fixed";
                modal.style.top = 0;
                modal.style.left =  0;
                modal.style.width = "100%";
                modal.style.height = "100%";
                modal.style.backgroundColor = "black";
                modal.style.zIndex = "9999";
                document.appendChild(modal);
                    const downloadButton = document.createElement("button");
                    const cancelButton = document.createElement("button");
                    downloadButton.addEventListener("click", () => {
                window.location.href = xrViewerApp;
                    });
                    cancelButton.addEventListener("click", () => {
                        modal.style.display = "none";});
            }
        }
       
        import { OrbitControls } from '/js/OrbitControls.js';
        import { VRMLLoader } from '/js/VRMLLoader.js';
        import { GLTFLoader } from '/js/GLTFLoader.js';
        import { MTLLoader } from '/js/MTLLoader.js';
        import { OBJLoader } from '/js/OBJLoader.js';
        import { OBJExporter } from '/js/OBJExporter.js';

        import * as THREE from '/js/three.module.js';
        import { ARButton } from '/js/ARButton.js';

        let requestedFile = window.location.pathname.substring(window.location.pathname.lastIndexOf('/') + 1);
        let requestedFileExt = requestedFile.substring(requestedFile.lastIndexOf('.') + 1);

        function loadAndRenderModel() {
        loader.load(requestedFile, (model) => {
            object = model;

            // Add the loaded 3D model to the scene
            scene.add(object);

            // Position the camera and render the scene
            camera.position.set(0, 0, 5);
            camera.lookAt(0, 0, 0);

            // Create an animate function to render the scene continuously
            function animate() {
                requestAnimationFrame(animate);
                renderer.render(scene, camera);
            }

            animate();
        });
    }

        let loader;
        if(requestedFileExt == "wrl"){
            loader = new VRMLLoader();
        }
        
        if(requestedFileExt == "gltf"){
            loader = new GLTFLoader();
        }
        
        if(requestedFileExt == "mtl"){
            loader = new MTLLoader();
        }
        
        if(requestedFileExt == "obj"){
            loader = new OBJLoader();
        }
        

        const threeArea = document.getElementById('three-area');

        let scene, camera, renderer, controls, clock;
        let mixer;

        let axesHelper;
        let spotLightTop, spotLightBottom, ambientLight;

        clock = new THREE.Clock();
        let deltaTime = 0;
        let totalTime = 0;
        let actions = [];


        function init(){

            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera( 75, window.innerWidth / window.innerHeight, 0.1, 4000 );

            renderer = new THREE.WebGLRenderer({ alpha: true });
            renderer.setClearColor( 0x000000, 0 );
            renderer.setSize( window.innerWidth, window.innerHeight );
            threeArea.appendChild( renderer.domElement );

            const activateAR = document.body.appendChild( ARButton.createButton( renderer ) );
                renderer.xr.enabled = true;
                renderer.setAnimationLoop( function () {
                    renderer.render( scene, camera );
                } );

            
            spotLightTop = new THREE.SpotLight( 0xffffff );
            spotLightTop.position.set( 0, 0, 1000 );
            scene.add( spotLightTop );

            ambientLight = new THREE.AmbientLight( 0xffffff );
            scene.add( ambientLight );


            loader.load( '../scenefiles/' + requestedFile, function ( object ) {
                if(requestedFileExt == "wrl"){
                    scene.add( object );
                }
                else if(requestedFileExt == "gltf"){
                    console.log(object);
                    mixer = new THREE.AnimationMixer( object.scene );
                    for(let animation of object.animations){
                        actions.push(mixer.clipAction(animation));
                        var action = mixer.clipAction(animation);
                        action.play();

                    }
                    
                    scene.add( object.scene );
                } 
                else if (requestedFileExt === "obj") {
                    const mtlLoader = new MTLLoader();
                    const mtlFile = requestedFile.replace(".obj", ".mtl");
                    
                    mtlLoader.load('../objAndMtlFiles/' + mtlFile, function (materials) {
                        materials.preload();
                        
                        const objLoader = new OBJLoader();
                        objLoader.setMaterials(materials);
                        
                        objLoader.load('../objAndMtlFiles/' + requestedFile, function (object) {
                            if (object instanceof THREE.Group) {
                                mixer = new THREE.AnimationMixer(object);
                                for (let animation of object.animations) {
                                    actions.push(mixer.clipAction(animation));
                                    var action = mixer.clipAction(animation);
                                    action.play();
                                }
                                scene.add(object);
                            } else {
                                console.error('Loaded object is not a valid instance of THREE.Group.');
                            }
                        });
                    });
                }
            } );


            axesHelper = new THREE.AxesHelper( 50 );
            scene.add( axesHelper );

            controls = new OrbitControls( camera, renderer.domElement );
            controls.dampingFactor = 10;

            camera.position.x = 0;
            camera.position.y = 0;
            camera.position.z = 100;

        }

        function animate() {
            requestAnimationFrame( animate );
            var delta = clock.getDelta();
            if ( mixer ) mixer.update( delta );

            renderer.render( scene, camera );
            controls.update();
        }

        init();
        animate();

        window.addEventListener('resize', onResize, false);

        function onResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        const sceneObjects = []; // Define the sceneObjects array to store added objects
        function loadNewObjFiles(file) {
            if (file) {
                const reader = new FileReader();
                
                const mtlLoader = new MTLLoader();
                const objFileName = file.name;
                const mtlFileName = objFileName.replace(".obj", ".mtl");
                console.log('New File Name:', mtlFileName);

                let existingFileName = requestedFile.replace(".obj", ".mtl");
                console.log('Existing File Name:', existingFileName);
                
                mtlLoader.load('../objAndMtlFiles/' + mtlFileName, function (materials) {
                    materials.preload();
                    reader.onload = function (e) {
                        const text = reader.result;
                        
                        const objLoader = new OBJLoader();
                        objLoader.setMaterials(materials);
                        const object = objLoader.parse(text);
                        scene.add(object);

                        // Store the added object
                        sceneObjects.push({ name: 'Custom Name', description: 'Custom Description', object });

                        // Enable the "Save As" button
                        document.getElementById('saveAsButton').disabled = false;
                    };
                    reader.readAsText(file);
                });
            }
            animate();
        }

        const saveAsButton = document.getElementById('saveAsButton');
        const fileInput = document.getElementById('fileInput');

        let addedObjects = [];

        fileInput.addEventListener('change', function (e) {
            const file = fileInput.files[0];
            const objFileName = file.name;
            const mtlFileName = objFileName.replace(".obj", ".mtl");

            loadNewObjFiles(file);
            addedObjects.push({ obj: objFileName, mtl: mtlFileName });      
        });

        function saveSceneAsOBJ(filename) {
            const exporter = new OBJExporter();
            const objData = exporter.parse(scene);
            const blob = new Blob([objData], { type: 'text/plain' });

            try {
                saveAs(blob, filename + '.obj');
            } catch (error) {
                console.error('Error saving OBJ file:', error);
            }
        }

        saveAsButton.addEventListener('click', async function () {
            const saveObjectName = prompt('Enter a name for the saved scene:');
            if (saveObjectName && addedObjects.length > 0) {
                saveSceneAsOBJ(saveObjectName);
                
                let existingFileName = requestedFile.replace(".obj", ".mtl");

                const fetchMTLFiles = addedObjects.map(obj => {
                    return fetch('../objAndMtlFiles/' + obj.mtl)
                        .then(response => response.text())
                });

                try {
                    const allMTLContents = await Promise.all(fetchMTLFiles);
                    const combinedMTLContent = allMTLContents.join('\n\n');
                    const existingMTLContent = await fetch('../objAndMtlFiles/' + existingFileName)
                        .then(response => response.text());
                    const finalMTLContent = existingMTLContent + '\n\n' + combinedMTLContent;
                    const mtlBlob = new Blob([finalMTLContent], { type: 'text/plain' });
                    saveAs(mtlBlob, `${saveObjectName}.mtl`);
                } catch (error) {
                    console.error('Error fetching or combining MTL files:', error);
                }
            }
        });
    </script>

