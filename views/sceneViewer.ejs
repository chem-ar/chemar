<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <!-- The title of the webpage -->
    <title>
      Dynamic AR.js & A-Frame Demo with Animations
    </title>

    <!-- Ensure proper scaling and disable zooming on mobile devices -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    
    <!-- Include A-Frame library for creating 3D/VR experiences -->
    <script src="https://aframe.io/releases/1.2.0/aframe.min.js"></script>
    <!-- Include AR.js extension for A-Frame to enable AR capabilities using the webcam -->
    <script src="https://cdn.jsdelivr.net/gh/AR-js-org/AR.js@3.3.2/aframe/build/aframe-ar.js"></script>

    <!-- Inline CSS to remove default margins, padding, and to hide overflow -->
    <style>
      body, html { margin: 0; padding: 0; overflow: hidden; height:100%;}
      #rotationButton {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
        padding: 10px 20px;
        background-color: rgba(0, 0, 0, 0.7);
        color: white;
        font-size: 16px;
        border: none;
        border-radius: 5px;
      }
      #rotationButton:hover {
        background-color: rgb(73, 77, 78, 0.7);
      }
      #rotationButton.toggled {
        background-color: rgba(0, 77, 165, 0.7);
      }
      #rotationButton.toggled:hover {
        background-color: rgba(37, 134, 245, 0.7);
      }
    </style>
  </head>
  <body>

    <button id="rotationButton">Toggle Rotation</button>

    <!-- Define an AR marker using a preset "hiro" pattern, and assign it an ID for future reference -->
    <a-scene arjs="sourceType: webcam; debugUIEnabled: false; detectionMode: mono_and_matrix; matrixCodeType: 3x3; 
    trackingMethod: best; maxDetectionRate: 30; smooth: true; smoothCount: 10; smoothTolerance: 0.01; smoothThreshold: 5;">
<!-- Define an AR marker using a preset "hiro" pattern, and assign it an ID for future reference -->      
      <a-marker
        type="pattern"
        url="/data/kanji.patt"
        id="marker">
      </a-marker>
        <!-- Add a camera entity to the scene so the AR content can be viewed from the correct perspective -->    
      <a-entity camera></a-entity>
    </a-scene>

    <!-- JavaScript Section for Dynamic Content and Animations -->
    <script>
      const sceneName = window.location.pathname.split("/").pop();

        fetch("/scenes/api/" + sceneName)
        .then(res => res.json())
        .then(data => {
          if (data.trackingMarker) {
            const m = document.querySelector("#marker"),
                  p = data.trackingMarker.position,
                  r = data.trackingMarker.rotation,
                  s = data.trackingMarker.scale;

            m.setAttribute("position", `${p.x} ${p.y} ${p.z}`);
            m.setAttribute("rotation", `${r.x} ${r.y} ${r.z}`);
            m.setAttribute("scale", `${s.x} ${s.y} ${s.z}`);
          }

          data.molecules.forEach(mol => {
            const marker = document.querySelector("#marker"),
                  ent = document.createElement("a-entity"),
                  fileName = mol.modelInfo.file_path.split('/').pop();
                  const modelInfo = mol.modelInfo;

            ent.setAttribute("gltf-model", `/${modelInfo.file_path.replaceAll('\\\\', '/')}`);
            ent.setAttribute("position", `${mol.position.x} ${mol.position.y} ${mol.position.z}`);

            const rot = mol.rotation;
            const rotStr = `${rot.x || 0} ${rot.y || 0} ${rot.z || 0}`;
            ent.setAttribute("rotation", rotStr);

            ent.setAttribute("scale", `${parseFloat(mol.scale.x)} ${parseFloat(mol.scale.y)} ${parseFloat(mol.scale.z)}`);
            ent.setAttribute("id", mol.modelInfo.name);

            marker.appendChild(ent);
          });
        })
        .catch(e => console.error("Error fetching scene from DB:", e));

    let sceneRotating = false;

    const rotButton = document.querySelector("#rotationButton")
    rotButton.addEventListener("click", toggleRotation);

    function toggleRotation() {
      sceneRotating = !sceneRotating;

      if (sceneRotating) {
        rotButton.classList.add("toggled");
      }
      else {
        rotButton.classList.remove("toggled");
      }

      Array.from(document.querySelector("#marker").children).forEach(ent => {
        if (sceneRotating) {
          ent.setAttribute("animation", "property: rotation; to: 0 360 0; loop: true; dur: 5000; easing: linear");
        }
        else {
          ent.removeAttribute("animation");
        }
      });
    }

  </script>

  </body>
</html>