  <body style='margin : 0px; overflow: hidden; font-family: Monospace;'>
  <div id="gui_container"></div>
  <div id="text">
    <a href = "/scenes/" class="btn UIButton">
     <span> ◄ Back to Scenes</span> 
    </a>
    <button type="button" class="btn UIButton" data-bs-toggle="modal" data-bs-target="#myModal">How does AR work?</button>
   
    <br />
  </div>

  

  <div class="modal fade" id="myModal" tabindex="-1" aria-labelledby="canvasModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
              <h1 class="modal-title text-white h5" >How does AR work?</h1>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
              <h2 class="modal-title text-white h4" >How can I see the molecules on my worksheet?</h2>
                <p class="myModal">To see the molecules that your instructor has added to your worksheet, hold you device's camera up to the kanji symbol on the page. 
                                    Once your device's camera recognizes this symbol you should see the intended molecules renderering on the page. To keep seeing these 
                                    molecules, make sure the marker is in view of your camera. For best results keep your device ~6 inches away from the page as this will allow 
                                    your camera to have it in view at all times.
                </p>
                <h2 class="modal-title text-white h4" >Can I see the molecules without my worksheet?</h2>
                <p class="myModal">To see the molecules without the use of a marker you can click the experimental AR button. This mode will allow you to view the molecules 
                  your instructor has added to the lesson without the marker in view. Within this mode you will be able to walk around the rendered molecule without the worry
                  of having the marker in view of the camera. Though please note this mode is still being developed in our lab so you may get some unexpected results when using it.
                </p>
            </div>
        </div>
    </div>
  </div>

  <!-- 
    Example created by Lee Stemkoski: https://github.com/stemkoski
    Based on the AR.js library and examples created by Jerome Etienne: https://github.com/jeromeetienne/AR.js/ and https://threejs.org/examples/?q=webxr
  -->
  <script type="module">
        import * as THREE from "/js/three.module.js";
        import { createModel } from "/js/scenes/rendering.js";
        import { ARButton } from "/js/ARButton.js";
        import { OrbitControls } from "/js/OrbitControls.js";
        import { adjustMolToMarker } from '/js/scenes/scene-mgmt.js';
      
        let requestedFile =
          window.location.pathname.substring(
            window.location.pathname.lastIndexOf("/") + 1
          ) + ".json";

        let moleculeData;

        fetch("/scenes" + "/" + requestedFile)
          .then((response) => response.json())
          .then((data) => {
            moleculeData = data;
            initialize();
            animate();
          });

        var scene, camera, renderer, clock, deltaTime, totalTime, clone, moleculeARGroup, controls, moleculeSizeDivisor = 128;

        var activeMolecules = []; // creating an array to keep track of active molecules and manipulate independently.

        var arToolkitSource, arToolkitContext;

        var markerX, markerY, markerZ;

        var markerRoot1, markerRoot2, markerVisible;

        function initialize() {

           ////////////////////////////////////////////////////////////
          // setup Scene
          ////////////////////////////////////////////////////////////

          scene = new THREE.Scene();

           ////////////////////////////////////////////////////////////
          // setup Light Sources
          ////////////////////////////////////////////////////////////
          // changed ambient light
          let ambientLight = new THREE.AmbientLight(0x070707, 1);
          scene.add(ambientLight);

          let spotLight = new THREE.SpotLight(0xffffff);
          spotLight.position.set(140, 65, 95);
          
          //Removed shadow settings to improve clarity of molecular models
          // shadows already removed in refractoring
          // spotLight.castShadow = true;

          // spotLight.shadow.mapSize.width = 1024;
          // spotLight.shadow.mapSize.height = 1024;

          // spotLight.shadow.camera.near = 500;
          // spotLight.shadow.camera.far = 4000;
          // spotLight.shadow.camera.fov = 30;

          scene.add(spotLight);

           ////////////////////////////////////////////////////////////
          // setup Camera
          ////////////////////////////////////////////////////////////

          camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.01, 20);
          scene.add(camera);

           ////////////////////////////////////////////////////////////
          // setup Renderer
          ////////////////////////////////////////////////////////////

          renderer = new THREE.WebGLRenderer({
            antialias: true,
            alpha: true,
            powerPreference: 'high-performance',
            precision: 'mediump'
          });
          renderer.shadowMap.enabled = false; //shadows disabled to improve clarity of molecular models
          renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // Cap pixel ratio for better performance
	        renderer.setSize(window.innerWidth, window.innerHeight);
          renderer.outputEncoding = THREE.sRGBEncoding;
          renderer.xr.enabled = true;

          document.body.appendChild(renderer.domElement);

           ////////////////////////////////////////////////////////////
          // setup Clock
          ////////////////////////////////////////////////////////////

          clock = new THREE.Clock();
          deltaTime = 0;
          totalTime = 0;

          ////////////////////////////////////////////////////////////
          // setup arToolkitSource
          ////////////////////////////////////////////////////////////

         arToolkitSource = new THREEx.ArToolkitSource({
            sourceType: "webcam",
            sourceWidth: 640,    // Reduced for faster processing
            sourceHeight: 480,   // Balanced resolution
            displayWidth: 640,   // Match source dimensions
            displayHeight: 480,
            deviceId: undefined  // Allow faster camera initialization
        });
          function onResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
             renderer.setSize( window.innerWidth, window.innerHeight );
            arToolkitSource.onResize();
            arToolkitSource.copySizeTo(renderer.domElement);
            if (arToolkitContext.arController !== null) {
              arToolkitSource.copySizeTo(arToolkitContext.arController.canvas);
            }
          }

          arToolkitSource.init(function onReady() {
            onResize();
          });

          // handle resize event
          window.addEventListener("resize", function () {
            onResize();
          });

          ////////////////////////////////////////////////////////////
          // setup arToolkitContext
          ////////////////////////////////////////////////////////////

          // create atToolkitContext
          arToolkitContext = new THREEx.ArToolkitContext({
            cameraParametersUrl: "/data/camera_para.dat",
            detectionMode: "mono",
            maxDetectionRate: 60,          // Increased for faster updates
            canvasWidth: 640,              // Balanced resolution for speed
            canvasHeight: 480,
            imageSmoothingEnabled: true,   // helps with different types of lighting
            thresholdMode: "adaptive" //helps with different types of lighting
          });

          // copy projection matrix to camera when initialization complete
          arToolkitContext.init(function onCompleted() {
            camera.projectionMatrix.copy(
              arToolkitContext.getProjectionMatrix()
            );
          });

          ////////////////////////////////////////////////////////////
          // setup ARButton
          ////////////////////////////////////////////////////////////
          const button = ARButton.createButton(renderer);
          document.body.appendChild(button);
          button.addEventListener("click", startAR);

          //TEMPORARY COMMENTING-OUT OF ORBITCONTROLS - causes unwanted movement of molecule

           ////////////////////////////////////////////////////////////
          // setup OrbitControls
          ////////////////////////////////////////////////////////////
          // controls = new OrbitControls(camera, renderer.domElement);
          // controls.dampingFactor = 10;
          // controls.minDistance = 1;
          // camera.position.x = 0;
          // camera.position.y = 0;
          // camera.position.z = 2;
          
          // //Three.js - OrbitControls Documentation: https://threejs.org/docs/#examples/en/controls/OrbitControls
          // //allow a user to zoom in/out and to rotate the molecule on their phone
          // controls.enableZoom = true;
          // controls.enableRotate = true;
          // controls.rotateSpeed = -0.4;
          // controls.zoomSpeed = 0.4;

          // controls.touches = {
          //     ONE: THREE.TOUCH.ROTATE, //Rotate molecule with 1 finger
          //     TWO: THREE.TOUCH.DOLLY, //Zoom with 2 fingers
          // };
          
          // controls.update();


          ////////////////////////////////////////////////////////////
          // setup markerRoots
          ////////////////////////////////////////////////////////////

          // build markerControls
          markerRoot1 = new THREE.Group();
          scene.add(markerRoot1);
          let markerControls1 = new THREEx.ArMarkerControls(
            arToolkitContext,
            markerRoot1,
            {
              type: "pattern",
              patternUrl: "/data/kanji.patt",
            }
          );

           ////////////////////////////////////////////////////////////
          // setup Populate Molcules to Marker
          ////////////////////////////////////////////////////////////
          moleculeARGroup = new THREE.Group();
          for (let item of moleculeData.molecules) {
            const marker = moleculeData.trackingMarker;
            createModel(
              item.modelInfo,
              item.position,
              item.rotation,
              item.scale
            ).then((molecule) => {
              adjustMolToMarker(molecule,marker);
              markerRoot1.add(molecule);  

              activeMolecules.push(molecule); // adding to active molecules array

              molecule.traverse(function(child) {
                  if (child.isMesh) {
                      child.castShadow = false;
                      child.receiveShadow = false;
                  }
              });

              // To further ensure all shadows are disabled on the molecules. 

              outlinePass.selectedObjects.push(molecule); 
              clone = molecule.clone();
              moleculeARGroup.add(clone);
            });
          }

          moleculeARGroup.visible = false;
      
        }

        function update() {
          // update artoolkit on every frame
          if (arToolkitSource.ready !== false){
            arToolkitContext.update(arToolkitSource.domElement);
            markerX = markerRoot1.position.x;
            markerY = markerRoot1.position.y;
            markerZ = markerRoot1.position.z;
          }
        }

        function startAR()  {

          moleculeARGroup.visible = true;
          markerRoot1.clear();
          camera.position.set(markerX, markerY, markerZ);
          //Dividing by 100 because coordinates are measured in centimetres
          moleculeARGroup.position.set(markerX/100, markerY/100, markerZ/100);
            moleculeARGroup.scale.set(
            moleculeARGroup.scale.x/moleculeSizeDivisor, 
            moleculeARGroup.scale.y/moleculeSizeDivisor, 
            moleculeARGroup.scale.z/moleculeSizeDivisor);
            moleculeARGroup.quaternion.copy(markerRoot1.quaternion);
            scene.add(moleculeARGroup);
        }

        function render() {
          renderer.render(scene, camera);
        }

        //start of section -- this section is NOT from the original above source 

        //this portion of code is developed by using the methods from this web article:
        // (December 13, 2024). "Detect Gestures and Swipes Using JavaScript Touch APIs" Sling Academy https://www.slingacademy.com/article/detect-gestures-and-swipes-using-javascript-touch-apis/ 
        let initialX, initialY;
        let initialDistance;
        let changedX, changedY;
        let diffX, diffY;
        const minClamp = 0.2;
        const maxClamp = 5.0;

        document.addEventListener("touchstart", function(event) {
          event.preventDefault();
          //grab x and y positions for 1 finger touch (prepare to drag)
          if(touches.length == 1) {
            initialX = event.touches[0].clientX;
            initialY = event.touches[0].clientY;
          }

          //if a user places two fingers, they likley wish to pinch for zoom in/out controls, grab the distance between the two fingers
          if(touches.length == 2) {
            //calculate the initial distance              
            const dx = event.touches[1].clientX - event.touches[0].clientX;
            const dy = event.touches[1].clientY - event.touches[0].clientY;
            initialDistance = Math.sqrt(dx * dx + dy * dy);
          }
        }, false);

        document.addEventListener("touchmove", function(event) {
          event.preventDefault();
          //drag to rotate, get difference in distance between start and end finger position
          if(event.touches.length == 1) {
            changedX = event.touches[0].clientX;
            changedY = event.touches[0].clientY;
              
            diffX = initialX - changedX;
            diffY = initialY - changedY;

            //drag the model (set the rotation values with a rotation speed vector)
            moleculeARGroup.rotation.x += diffY * 0.05;
            moleculeARGroup.rotation.y += diffX * 0.05;
              
            //reset position to new position
            initialX = touches[0].clientX;
            initialY = touches[0].clientY;
          }

          //pinch to zoom
          if(event.touches.length == 2) {
            // get the new distance between the fingers after user "pinches"
            const dx = event.touches[1].clientX - event.touches[0].clientX;
            const dy = event.touches[1].clientY - event.touches[0].clientY;
            const distance = Math.sqrt(dx * dx + dy * dy);

            //if the initial distance between fingers was not null (grabed the distance once two fingers are placed to screen), get the difference in distance
            if(initialDistance != null) {
              const dPinch = distance - initialDistance;
              const scale = 1 + dPinch * 0.05;

              //clamping for distance error avoidance
              moleculeARGroup.scale.x *= scale;
              moleculeARGroup.scale.y *= scale;
              moleculeARGroup.scale.z *= scale;
                
              // scaling and clamping learned and developed from: 
              // (December 12, 2024) "Clamping Values to a Range with JavaScript Math Functions". Sling Academy. https://www.slingacademy.com/article/clamping-values-to-a-range-with-javascript-math-functions/ 
              moleculeARGroup.scale.x = Math.min(Math.max(moleculeARGroup.scale.x, minClamp), maxClamp);
              moleculeARGroup.scale.y = Math.min(Math.max(moleculeARGroup.scale.y, minClamp), maxClamp);
              moleculeARGroup.scale.z = Math.min(Math.max(moleculeARGroup.scale.z, minClamp), maxClamp);

            } 
            //reset values, initial distance should now be the changed distance
            initialDistance = distance;
            initialX = null;
            initialY = null;
          }
        }, false);

        document.addEventListener("touchend", function(event) {
          event.preventDefault();
          //if user goes from 2 fingers to 1, they may want to now drag, reset drag to current x and y positions
          if(touches.length == 1) {
            initialX = event.touches[0].clientX;
            initialY = event.touches[0].clientY;
          }
          //else reset all values
          else {
            initialX, initialY = 0;
            changedX, changedY = 0;
            initialDistance, distance = 0;
            diffX, diffY = 0;
          }
        }, false);

        //end of seciton

        // Bug fix: originally, we had 3 render calls happening in every frame
        // Bug fix explained: we only need one animation loop at requestAnimationFrame(), 
        // and one render call per frame at render().

        /**
         * Main animation loop
         * Schedules update and render calls
         * 
        */

        function animate() {
          requestAnimationFrame(animate); 
          // this section of code overwrites the above touch events, remove it entirley

          
          // deltaTime = clock.getDelta();
          // totalTime += deltaTime;

          // if (!moleculeARGroup.visible){
          //   //Rotate each molecule on its own axis
          //   activeMolecules.forEach((molecule) => {
          //     molecule.rotation.y += deltaTime * 0; // Edited to remove rotation
          //     molecule.rotation.x += deltaTime * 0; // Edited to remove rotation

          //     // May be edited as desired to add more rotation effects.
          //   });
          // }
          // else {
          //   // moleculeARGroup.rotation.y += 0.01;
          // }

          update();
          render(); 
        }

      </script>
    </body>
  </html>
