<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Dynamic AR.js & model-viewer Demo</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">

    <!-- A-Frame Library -->
    <script src="https://aframe.io/releases/1.2.0/aframe.min.js"></script>

    <!-- AR.js for A-Frame -->
    <script src="https://cdn.jsdelivr.net/gh/AR-js-org/AR.js@3.3.2/aframe/build/aframe-ar.js"></script>

    <!-- model-viewer Library -->
    <script type="module" src="https://unpkg.com/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>

    <style>
      body, html {
        margin: 0;
        padding: 0;
        overflow: hidden;
      }
      /* Parent container for all models */
      #modelsContainer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
      }
      /* Each model container */
      .modelContainer {
        width: 300px;  /* Adjust dimensions as needed */
        border: 2px dotted red;  /* For visualization purposes */
        height: 300px;
        margin: 10px;
        display: none;  /* Hide by default until marker is found */
      }
    </style>
  </head>
  
  <body>
    <!-- A-Frame scene with AR.js enabled for marker detection -->
    <a-scene embedded arjs="sourceType: webcam;">
      <!-- Using the default Hiro marker -->
      <a-marker preset="hiro" id="marker">
        <a-entity geometry="primitive: box" material="opacity: 0;"></a-entity>
      </a-marker>
      <a-entity camera></a-entity>
    </a-scene>
    
    <!-- Container where all model elements will be dynamically added -->
    <div id="modelsContainer"></div>

    <script>
      // add a model
      function addModel(molecule) {

        const model = molecule.modelInfo.files.glb;
        const filePath = `../modelfiles/${model}`;
        const position = molecule.modelInfo.position;
        const rotation = molecule.modelInfo.rotation;
        const scale = molecule.modelInfo.scale;

        const marker = document.querySelector("#marker");

        // hold the model
        const modelEntity = document.createElement("a-entity");

        modelEntity.setAttribute("gltf-model", filePath);
        modelEntity.setAttribute("scale", "0.5 0.5 0.5"); 
        modelEntity.setAttribute("position", "0 0 0"); 
        modelEntity.setAttribute("rotation", "0 0 0"); 

        // model stays in place
        marker.appendChild(modelEntity);
      }


      // Function to update display state for all model containers
      function updateModelDisplay(state) {
        const modelContainers = document.querySelectorAll('.modelContainer');
        modelContainers.forEach(container => {
          container.style.display = state;
        });
      }

      // Get the AR marker element from the A-Frame scene
      const marker = document.querySelector('#marker');

      // Add event listeners for marker detection
      marker.addEventListener('markerFound', () => {
        console.log('Marker found!');
        updateModelDisplay('block');
      });

      marker.addEventListener('markerLost', () => {
        console.log('Marker lost!');
        updateModelDisplay('none');
      });

      // Example: dynamically add models on page load
      // You can add as many models as needed at runtime.

      let requestedFile =
        window.location.pathname.substring(
          window.location.pathname.lastIndexOf("/") + 1
        ) + ".json";

      console.log(requestedFile);

      fetch("/scenes/" + requestedFile)
        .then((response) => {
          if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
          }
          return response.json();
        })
        .then((data) => {
          data.molecules.forEach((molecule) => {
            addModel(molecule);
          });
        })
        .catch((error) => {
          console.error("Error fetching JSON:", error);
        });

      // addModel('/Astronaut.glb', '3D Model 1');
      // addModel('/Box.glb', '3D Model 1');
      // To add more models later, simply call addModel() with the appropriate source and alt text.
    </script>
  </body>
</html>