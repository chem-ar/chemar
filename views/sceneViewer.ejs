<!DOCTYPE html>
<html lang="en">
  <head>
    <meta
      name="viewport"
      content="width=device-width, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0"
    />
    <title>Model Viewer with AR.js</title>

    <!-- A-Frame and AR.js libraries for marker detection -->
    <script src="https://aframe.io/releases/1.2.0/aframe.min.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/AR-js-org/AR.js@3.3.2/aframe/build/aframe-ar.js"></script>
    <!-- model-viewer Library -->
    <script type="module" src="https://unpkg.com/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>

    <style>
      /* AR.js scene fills the screen and is placed behind other elements */
      a-scene {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1;
      }
      /* The model-viewer container is centered and initially hidden */
      #model-viewer-container {
        position: absolute;
        width: 300px;
        height: 300px;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: none;
        transition: transform 0.2s ease;
      }
      /* Styling for the model-viewer element (if needed) */
      model-viewer {
        width: 100%;
        height: 100%;
        background-color: transparent;
        pointer-events: none;
      }
      .UIButton {
        background-color: #0071EB;
        color: white;
        padding: 8px 16px;
        border: none;
        cursor: pointer;
        position: absolute;
        top: 16px;
        left: 16px;
      }
      .model-container {
        position: relative;
        width: 100%;
        height: 100%;
      }
      /* Back button styling */
      #text {
        position: absolute;
        bottom: 20px;
        width: 100%;
        text-align: center;
        z-index: 1;
      }
    </style>
  </head>

  <body style="margin: 0px; overflow: hidden; font-family: Monospace;">
    <!-- A-Frame scene with AR.js enabled for marker detection -->
    <a-scene embedded arjs="sourceType: webcam;">
      <!-- Marker element using the default "hiro" preset -->
      <a-marker preset="hiro" id="marker">
        <a-entity geometry="primitive: box" material="opacity: 0;"></a-entity>
      </a-marker>
      <a-entity camera></a-entity>
    </a-scene>
    
    <!-- Container for model-viewer elements (populated via JSON file selection) -->
    <div id="model-viewer-container"></div>
    
    <!-- Back Button -->
    <div id="text">
      <a href="javascript:history.back();" class="btn UIButton">
        <span> ◄ Back to Scenes</span> 
      </a>      
    </div>

    <script>
      // Use the same method to select files as before.
      let requestedFile =
        window.location.pathname.substring(
          window.location.pathname.lastIndexOf("/") + 1
        ) + ".json";
      console.log(requestedFile);

      fetch("/scenes/" + requestedFile)
        .then((response) => {
          if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
          }
          return response.json();
        })
        .then((data) => {
          data.molecules.forEach((molecule) => {
            const files = molecule.modelInfo.files;
            for (const [fileType, fileName] of Object.entries(files)) {
              const filePath = `/modelfiles/${fileName}`;
              console.log(filePath);
              if (fileType === "glb" || fileType === "gltf") {
                initializeModelViewer(filePath, fileType);
              }
            }
          });
        })
        .catch((error) => {
          console.error("Error fetching JSON:", error);
        });

      function initializeModelViewer(filePath, fileType) {
        const modelViewerContainer = document.getElementById("model-viewer-container");

        const modelContainer = document.createElement("div");
        modelContainer.className = "model-container";

        const modelViewer = document.createElement("model-viewer");
        modelViewer.setAttribute("src", filePath);
        modelViewer.setAttribute("alt", "A 3D model");
        modelViewer.setAttribute("ar", "");
        modelViewer.setAttribute("ar-modes", "webxr scene-viewer quick-look");
        modelViewer.setAttribute("camera-controls", "");
        modelViewer.setAttribute("auto-rotate", "");
        modelViewer.setAttribute("shadow-intensity", "1");

        const arButton = document.createElement("button");
        arButton.setAttribute("slot", "ar-button");
        arButton.className = "UIButton";
        arButton.textContent = "View in AR";

        modelViewer.appendChild(arButton);
        modelContainer.appendChild(modelViewer);
        modelViewerContainer.appendChild(modelContainer);
      }

      // Set up AR.js marker event handling.
      const marker = document.querySelector("#marker");
      // When the marker is detected, show the model-viewer container.
      marker.addEventListener("markerFound", function() {
        console.log("Marker found!");
        document.getElementById("model-viewer-container").style.display = "block";
      });
      // When the marker is lost, hide the model-viewer container.
      marker.addEventListener("markerLost", function() {
        console.log("Marker lost!");
        document.getElementById("model-viewer-container").style.display = "none";
      });
    </script>
  </body>
</html>