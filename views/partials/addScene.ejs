<style>
    .btn-green {
        background-color: #097242;
        color: white;
    }

    .btn-green:hover {
        background-color: #075c33;
        color: white;
    }

    .btn-customsubmit {
        background-color: #0071EB;
        color: white;
    }

    .btn-customsubmit:hover {
        background-color: #005bb5;
        color: white;
    }

/* Toggle Button */
*, *::before, *::after {
  box-sizing: border-box;
  transition: 400ms all ease-in-out 50ms;
  backface-visibility: hidden;
}


.form-switch {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 1rem;
}


.form-switch input[type="checkbox"] {
  display: none;
}


.form-switch label {
  position: relative;
  width: 80px;
  height: 30px;
  background-color: rgba(43, 43, 43, 1); 
  border-radius: 50px;
  cursor: pointer;
  display: inline-block;
  box-shadow: 0 0 4px rgba(0, 0, 0, 0.3);
  overflow: hidden; 
}


.form-switch label::before {
  content: '✖'; 
  position: absolute;
  width: 26px;
  height: 26px;
  background: rgba(255, 255, 255, 1);
  border-radius: 50%;
  top: calc(50% - 13px); 
  left: 3px; 
  color: rgba(43, 43, 43, 1);
  font-size: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(0) rotate(0deg); 
  transition: transform 0.4s ease, background 0.4s ease, color 0.4s ease;
}


.form-switch input[type="checkbox"]:checked + label {
  background-color: rgba(73, 168, 68, 1);
  box-shadow: 0 0 6px rgba(73, 168, 68, 0.8);
}

.form-switch input[type="checkbox"]:checked + label::before {
  content: '✔'; 
  transform: translateX(50px) rotate(360deg); 
  background: rgba(255, 255, 255, 1); 
  color: rgba(73, 168, 68, 1); 
  transition: transform 0.4s ease-in-out, color 0.4s ease-in-out;
}


.form-switch .toggle-label {
  font-size: 14px;
  color: white;
  margin-left: 10px;
  white-space: nowrap;
  display: inline-block;
}


button#newSceneAddBtn {
  margin-left: 5px; 
}

.pg-main-content .form-group {
  display: flex;
  flex-direction: column;
  margin-bottom: 10px;
}

.pg-main-content .form-group input {
  margin-bottom: 5px;
  padding: 8px;
  font-size: 14px;
}

button#newSceneAddBtn {
  width: calc(100% - 20px); 
}
</style>

<!-- Add Scene -->
<div class="row content">
    <div class="col-12 text-start text-white main-background-color">
        <button class="btn btn-green" type="button" data-bs-toggle="collapse" data-bs-target="#collapseExample"
                aria-expanded="false" aria-controls="collapseExample">
            Add New Scene
        </button>

        <div class="collapse" id="collapseExample">
            <div class="col-12 text-start text-white main-background-color">
                <div class="row">
                    <div class="col-12 col-sm-9 col-md-6">
                        <h4 class="mb-1 mt-2">Scene Name:</h4>
                        <input type="text" class="form-control" id="newSceneName" name="name" placeholder="Scene Name"
                               required>
                        <h4 class="mb-1 mt-2">Description:</h4>
                        <input type="text" class="form-control" id="newSceneDesc" name="description"
                               placeholder="Description" required>

                               <div class="form-switch">
                                <input type="checkbox" id="studentAccessibleCheckbox" name="studentAccessible" value="true">
                                <label for="studentAccessibleCheckbox"></label>
                                <span class="toggle-label">Visible for students?</span>
                            </div>

                        <button id="newSceneAddBtn" class="btn btn-customsubmit form-control my-2">Add scene</button>
                    </div>
                    <div class="col-12 col-sm-3">
                        <textarea class="form-control d-none" name="preview" id="preview"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
    </div>
</div>