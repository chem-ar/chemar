<div class="input-group flex-nowrap">    
    <select name="add-model-select" id="add-model-select" class="form-select">
        <option value="">Pick a model</option>
    </select>
    <button type="button" class="btn btn-info" id="add-model-btn">
        <span
            id="add-model-spinner"
            class="spinner-border spinner-border-sm"
            role="status"
            aria-label="Adding"
            style="display: none;"
        ></span>
        Add
    </button>
</div>

<script type="module">
    import { createModel } from '/js/scenes/rendering.js';
    import { addModelToScene } from '/js/scenes/scene-mgmt.js';
    import { addMolToMenu } from '/js/scenes/add-mol-to-menu.js';

    const addModelSelect = document.getElementById('add-model-select');
    const addModelBtn = document.getElementById('add-model-btn');
    const addModelSpinner = document.getElementById('add-model-spinner');
    const moleculeList = document.getElementById('molecule-list');

    let models = [];

    fetch('/sceneEditor/user/models', {
    credentials: 'include'
})
.then(response => {
    if (!response.ok) {
        throw new Error(`Server returned status code ${response.status}`);
    }
    return response.json();
})
.then(data => {
    models = data;

    const options = models.map(modelInfo => {
        const option = document.createElement('option');
        option.value = modelInfo.id;
        option.text = modelInfo.name;
        return option;
    });

    addModelSelect.append(...options);
})
.catch(error => {
    toastr.error(
        error.message,
        "Failed to populate list of models"
    );
});

    
addModelBtn.addEventListener('click', () => {
    const option = addModelSelect.selectedOptions[0];
    const modelId = option.value;
    if (modelId === '') return;

    const modelInfo = models.find(model => model.id == modelId);

    console.log("Original file path:", modelInfo.file_path);

    // Replace backslashes with forward slashes, then remove "public/" prefix
    let filePath = modelInfo.file_path.replace(/\\/g, '/').replace(/^public\//, '');

    console.log("Corrected file path:", filePath);

    const fileExtension = filePath.split('.').pop().toLowerCase();
    let files = {};

    if (fileExtension === 'obj') {
        files.obj = filePath;
        files.mtl = filePath.replace('.obj', '.mtl');
    } else if (fileExtension === 'glb') {
        files.glb = filePath;
    } else if (fileExtension === 'gltf') {
        files.gltf = filePath;
    }

    const formattedModelData = { files };
    console.log("Formatted Model Data:", formattedModelData);

    addModelSpinner.style.display = '';
    addModelBtn.disabled = true;

    createModel(formattedModelData)
    .then(createdModel => {        
        addModelToScene(modelInfo, createdModel);
        addMolToMenu(createdModel.object, modelInfo.name, moleculeList);
        window.currentSceneModels.push({
            object: createdModel.object,
            name: modelInfo.name,
            file_path: modelInfo.file_path,
            animations: []
        });
        toastr.success(`${modelInfo.name} added successfully!`, "Success", {
            timeOut: 3000,
            positionClass: 'toast-top-right',
            progressBar: true
        });
    })
    .catch(error => toastr.error(error.message, "Failed to add model"))
    .finally(() => { 
        addModelSpinner.style.display = 'none';
        addModelBtn.disabled = false;
    });
});

</script>
