<!-- fire base links -->
<script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-database-compat.js"></script>

<!-- Add Molecule -->
<div class="row content">
    <div class="col-12 text-start text-white bg-dark">
        <!-- Button to trigger molecule search -->
        <button class="btn btn-outline-success" type="button" data-bs-toggle="collapse" data-bs-target="#searchMenu"
            aria-expanded="false" aria-controls="searchMenu">
            <!-- Search icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
            </svg>
            Add New Molecule
        </button>
        <div class="row">
            <div class="col-12 mt-2">
                <!-- Search menu collapse -->
                <div class="collapse multi-collapse" id="searchMenu">
                    <!-- Input field for molecule name -->
                    <div class="input-group flex-nowrap">
                        <input type="text" id="search-field" class="form-control" placeholder="Molecule Name" aria-label="Username" aria-describedby="addon-wrapping">
                        <!-- Button to initiate molecule search -->
                        <button class="btn btn-info" type="button" id="search-button">Search</button>
                    </div>
                    <div class="row">
                        <div class="col-12 mb-2">
                            <!-- Container for displaying search results -->
                            <div id="search-results">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Initialize Firebase with your credentials
        const firebaseConfig = {
            databaseURL: "https://chemar-5845a-default-rtdb.firebaseio.com/",
        };

        firebase.initializeApp(firebaseConfig);

        function testFirebaseConnection() {
            const testValue = "Hello, Firebase!"; // Change this to any test value

            // Create a reference to a test path in your Firebase database
            const testRef = firebase.database().ref("testPath");

            // Set the test value to the specified path
            testRef.set(testValue)
                .then(() => {
                    console.log("Firebase connection test successful!");
                })
                .catch(error => {
                    console.error("Firebase connection test failed:", error);
                });
        }

        const apikey = '70DYPVRnsRXA4S0tALUyyM2VoD5YZGat';
        const searchField = document.getElementById("search-field");
        const searchButton = document.getElementById("search-button");
        const searchResults = document.getElementById("search-results");

        searchButton.addEventListener("click", function (event) {
            event.preventDefault();
            searchChemSpider(searchField.value);
        });

        function searchChemSpider(compoundName) {
            if (compoundName === "") {
                searchResults.innerHTML = `<div class="text-warning pt-2 px-2">Please enter a search term</div>`;
            } else {
                const headers = {
                    "Content-Type": "application/json",
                    "apikey": apikey
                };
                var URL = `https://api.rsc.org/compounds/v1/filter/name`;
                searchResults.innerHTML = `<div class="pt-2 px-2">Searching</div>`;

                const bodyContent = {
                    name: compoundName
                };

                const requestOptions = {
                    method: "POST",
                    headers: headers,
                    body: JSON.stringify(bodyContent)
                };

                fetch(URL, requestOptions)
                    .then(response => response.json())
                    .then(data => {
                        // get the results of the query-id
                        URL = `https://api.rsc.org/compounds/v1/filter/${data["queryId"]}/results`;
                        const requestOptions = {
                            method: "GET",
                            headers: headers,
                        };
                        // this grabs the results of the query-id which is the record-id
                        fetch(URL, requestOptions)
                            .then(response => response.json())
                            .then(data => {
                                // passes a list of record-ids
                                displaySearchResults(data["results"], searchResults);
                            })
                            .catch(error => {
                                console.error("Error:", error);
                            });
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        // Handle any errors here
                    });
            }
        }

        function displaySearchResults(data, container) {
            // data contains a list of record-ids
            if (data.length === 0) {
                container.innerHTML = `<p class="text-danger p-2">No results found</p>`;
            } else {
                container.innerHTML = ``;

                const searchResultTable = document.createElement('table');
                searchResultTable.classList = 'table text-white mb-0';
                container.appendChild(searchResultTable);

                const tableBody = document.createElement('tbody');
                searchResultTable.appendChild(tableBody);

                // Use Promise.all to wait for all details to be fetched before updating the table
                Promise.all(data.map(recordId => getRecordIdDetails(recordId)))
                    .then(detailsList => {
                        detailsList.forEach(listDetails => {
                            const row = tableBody.insertRow();
                            const cell1 = row.insertCell(0);
                            const cell2 = row.insertCell(1);

                            cell1.classList.add('text-break');
                            cell1.innerHTML = listDetails[0] + "<br>" + listDetails[1];
                            let addButton = document.createElement('button');
                            addButton.classList = 'btn btn-outline-light btn-block';
                            addButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16"><path d="M8 0a1 1 0 0 1 1 1v6h6a1 1 0 0 1 0 2H9v6a1 1 0 0 1-2 0V9H1a1 1 0 0 1 0-2h6V1a1 1 0 0 1 1-1z"/></svg> Add Molecule`;
                            
                            addButton.addEventListener("click", function (event) {
                                event.preventDefault();
                                addToFirebase(listDetails[0], listDetails[1]);
                            });

                            cell2.appendChild(addButton);
                            cell2.classList = 'w-25';
                        });
                    })
                    .catch(error => {
                        console.error("Error:", error);
                    });
            }
        }

        function getRecordIdDetails(recordId) {
            var URL = `https://api.rsc.org/compounds/v1/records/${recordId}/details?fields=Formula`;
            const headers = {
                "Content-Type": "application/json",
                "apikey": apikey
            };
            const requestOptions = {
                method: "GET",
                headers: headers,
            };

            return new Promise((resolve, reject) => {
                fetch(URL, requestOptions)
                    .then(response => response.json())
                    .then(data => {
                        var recordDetails = [];
                        // make string look more formatted
                        var newFormula = data["formula"].replaceAll("{", "").replaceAll("}", "").replaceAll("^", "").replaceAll("_", "");
                        recordDetails.push(newFormula);

                        URL = `https://api.rsc.org/compounds/v1/records/${recordId}/details?fields=CommonName`;
                        fetch(URL, requestOptions)
                            .then(response => response.json())
                            .then(data => {
                                recordDetails.push(data["commonName"]);
                                resolve(recordDetails);
                            })
                            .catch(error => {
                                console.error("Error:", error);
                                reject(error);
                            });
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        reject(error);
                    });
            });
        }

        function addToFirebase(formula, commonName) {
    // Create a reference to the 'molecules' path in your Firebase database
    const moleculesRef = firebase.database().ref("molecules");

    // Check if the molecule already exists in the database
    moleculesRef.orderByChild("formula").equalTo(formula).once("value")
        .then(snapshot => {
            if (!snapshot.exists()) {
                // Molecule does not exist, proceed with adding to Firebase
                // Generate a unique key for the new molecule
                const newMoleculeKey = moleculesRef.push().key;

                // Prepare the data for the new molecule
                const newMoleculeData = {
                    formula: formula,
                    commonName: commonName,
                    // Add any other properties you want to store
                };

                // Set the data for the new molecule at the generated key
                moleculesRef.child(newMoleculeKey).set(newMoleculeData)
                    .then(() => {
                        console.log("Molecule added to Firebase successfully!");
                        alert("Molecule added to Firebase successfully!");
                    })
                    .catch(error => {
                        console.error("Error adding molecule to Firebase:", error);
                        alert("Error adding molecule to Firebase. Please try again.");
                    });
            } else {
                console.log("Molecule already exists in Firebase!");
                alert("Molecule already exists in Firebase!");
            }
        })
        .catch(error => {
            console.error("Error checking for existing molecule:", error);
            alert("Error checking for existing molecule. Please try again.");
        });
}

    });
</script>


