<!-- Add Model -->
<div class="row content">
  <div class="col-12 text-start text-white bg-dark">
    <div>
      <button class="btn btn-outline-success" type="button" id="addAdminButton" data-bs-toggle="collapse" data-bs-target="#addAdmin" aria-expanded="false" aria-controls="addAdmin">
        Add Admin
      </button>
    </div>
  </div>

  <div class="row">
    <form class=" collapse multi-collapse" id="addAdmin" enctype="multipart/form-data">
      <div class="row d-flex flex-wrap">
        <div class="col-12 col-sm-6 d-flex  flex-wrap">
          <h4>Email:</h4>
          <input type="email" class="form-control" id="email" name="email" placeholder="Admin Dal Email" required>
          <h4>Password</h4>
          <input type="password" class="form-control" id="password" name="password" placeholder="Password" required>
          <small id="passwordFeedback" class="form-text mb-2"></small>
          <div class="w-100"></div>
          <small class="text-bright-white">Password Requirements:</small>
          <ul class="text-bright-white small mb-0">
            <li>At least 7 characters long</li>
            <li>At least one uppercase letter</li>
            <li>At least one lowercase letter</li>
            <li>At least one number</li>
            <li>At least one symbol (@!$%*?&)</li>
          </ul>
          <h4 class="w-100">Admin Role<i class="ms-2 fa-solid fa-caret-down"></i></h4>
          <select id="adminRole" class="form-control custom-select">
            <option value="admin">Admin<i class="fa-solid fa-caret-down"></i></option>
            <option value="owner">Owner</option>
          </select>

          <button class="btn btn-success form-control my-2" id="addBtn">
            <span id="addBtnSpinner" class="spinner-border spinner-border-sm" role="status" aria-label="Loading" style="display: none;"></span>
            Add
          </button>
        </div>
        <div class="col-12 col-sm-6 d-flex align-content-stretch flex-wrap">
          <textarea class="form-control" name="preview" id="preview" style="display: none"></textarea>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://kit.fontawesome.com/62461c2b58.js" crossorigin="anonymous"></script>
<script type="module">
  const addAdminForm = document.getElementById('addAdmin');
  const passwordInput = document.getElementById('password');
  const passwordFeedback = document.getElementById('passwordFeedback');

  passwordInput.addEventListener('input', () => {
    const password = passwordInput.value;
    if (validatePassword(password)) {
      passwordFeedback.textContent = "Strong Password";
      passwordFeedback.style.color = "green";
    } else {
      passwordFeedback.textContent = "Weak Password";
      passwordFeedback.style.color = "red";
    }
  });

  addAdminForm.addEventListener('submit', e => {
    let email = document.getElementById('email').value;
    let password = document.getElementById('password').value;
    let adminType = false
    if (document.getElementById('adminRole').value == 'owner') {
      adminType = true
    }
    e.preventDefault();
    setAdminAdding(true);

    const formData = new FormData(addAdminForm);
    fetch('/alladmin/addadmin', {
        method: 'POST',
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ email, password, adminType })
      })
      .then(async res => {
        if (res.ok) {
          fetchAdmins()
          addAdminForm.reset()
          document.getElementById('addAdminButton').setAttribute('class', 'btn btn-outline-success collapse')
          document.getElementById('addAdminButton').setAttribute('aria-expanded', 'false')
        }else if(res.status == 401){
          toastr.error('Password Requirements Unmatched')
        } else {
          console.error("Failed to delete admin.");
        }
      })
      .catch(err => {
        toastr.error(err.message, "Failed to add Admin");
      })
      .finally(() => setAdminAdding(false));
  });

  function validatePassword(password){
    const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@#$%^&*!])[A-Za-z\d@#$%^&*!]{7,}$/;
    return regex.test(password);
  }
  function setAdminAdding(isadding) {
    const spinner = document.getElementById('addBtnSpinner');
    const addBtn = document.getElementById('addBtn');

    if (isadding) {
      spinner.style.display = '';
      addBtn.disabled = true;
    } else {
      spinner.style.display = 'none';
      addBtn.disabled = false;
    }
  }
</script>