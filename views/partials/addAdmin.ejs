<style>
  .btn-green {
      background-color: #097242;
      color: white;
  }

  .btn-green:hover {
      background-color: #075c33;
      color: white;
  }

  .btn-customsubmit {
      background-color: #0071EB;
      color: white;
  }

  .btn-customsubmit:hover {
      background-color: #005bb5;
      color: white;
  }
</style>

<!-- Add Admin -->
<div class="row content">
  <div class="col-12 text-start text-white">
    <div>
      <button class="btn btn-green" type="button" id="addAdminButton" data-bs-toggle="collapse" data-bs-target="#addAdmin" aria-expanded="false" aria-controls="addAdmin">
        Add Admin
      </button>
    </div>
  </div>

  <div class="row">
    <form class=" collapse multi-collapse" id="addAdmin" enctype="multipart/form-data">
      <div class="row d-flex flex-wrap">
        <div class="col-12 col-sm-6 d-flex  flex-wrap">
          <h4>Email:</h4>
          <input type="email" class="form-control" id="email" name="email" placeholder="Admin Dal Email" required>
          <h4>Password</h4>
          <input type="password" class="form-control" id="password" name="password" placeholder="Password" required>
          <h4>Admin Role</h4>
          <select class="form-select" id="adminRole" aria-label="Default select example" required>
            <option value="" selected>Select Admin Role</option>
            <option value="admin">Admin</option>
            <option value="owner">Owner</option>
          </select>

          <button class="btn btn-customsubmit form-control my-2" id="addBtn">
            <span id="addBtnSpinner" class="spinner-border spinner-border-sm" role="status" aria-label="Loading" style="display: none;"></span>
            Add
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script src="https://kit.fontawesome.com/62461c2b58.js" crossorigin="anonymous"></script>
<script type="module">
  const addAdminForm = document.getElementById('addAdmin');
  addAdminForm.addEventListener('submit', e => {
    let email = document.getElementById('email').value;
    let password = document.getElementById('password').value;
    let adminType = false
    if (document.getElementById('adminRole').value == 'owner') {
      adminType = true
    }
    e.preventDefault();
    setAdminAdding(true);

    const formData = new FormData(addAdminForm);
    fetch('/alladmin/addadmin', {
        method: 'POST',
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ email, password, adminType })
      })
      .then(async res => {
        let result = await res.json();
        if (res.ok) {
            toastr.success(result.message, "Admin added successfully");

            // Refresh the admin list
            fetchAdmins();

            // Reset the form
            addAdminForm.reset();

            // Collapse the add admin button
            document.getElementById('addAdminButton').setAttribute('class', 'btn btn-outline-success collapse');
            document.getElementById('addAdminButton').setAttribute('aria-expanded', 'false');
        } else {
            let error = result.error;
            console.error("Failed to add admin:", error);
            toastr.error(error || "Failed to add admin", "Error");
        }
    })
    .catch(err => {
        toastr.error(err.message, "Failed to add Admin");
    })
    .finally(() => setAdminAdding(false)); // Ensure this function is defined to handle the UI state
});

  function setAdminAdding(isadding) {
    const spinner = document.getElementById('addBtnSpinner');
    const addBtn = document.getElementById('addBtn');

    if (isadding) {
      spinner.style.display = '';
      addBtn.disabled = true;
    } else {
      spinner.style.display = 'none';
      addBtn.disabled = false;
    }
  }
</script>