<!-- Add Model -->
<div class="row content">
    <div class="col-12 text-start text-white bg-dark">
        <div>
            <button class="btn btn-outline-success" type="button" data-bs-toggle="collapse" data-bs-target="#uploadFile"
                aria-expanded="false" aria-controls="uploadFile">
                Upload File 
            </button>
        </div>
    </div>

    <div class="row">
        <form class=" collapse multi-collapse" action="/addmodel/saveModel" method="POST" id="uploadFile" enctype="multipart/form-data">
            <div class="row d-flex flex-wrap">
                <div class="col-12 col-sm-6 d-flex  flex-wrap">
                    <h4>Model name:</h4>
                    <input type="text" class="form-control" id="modelName" name="name" placeholder="Ex: molecule_diagramName_number"  required>
                    <h4>Description:</h4>
                    <input type="text" class="form-control" id="modelDescription" name="modelDescription" placeholder="Model description" required>
                    <h4>Files (.obj and .mtl):</h4>
                    <input type="file" class="form-control" id="objFileName" name="objFileName" placeholder="File name" onchange="" 
                    required accept=".obj">
                    <input type="file" class="form-control" id="mtlFileName" name="mtlFileName" placeholder="File name" onchange="" 
                    required accept=".mtl">
                    <button class="btn btn-success form-control my-2" id="uploadBtn">Upload</button>
                </div>
                <div class="col-12 col-sm-6 d-flex align-content-stretch flex-wrap">
                    <textarea class="form-control" name="preview" id="preview" style="display: none"></textarea>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('fileName').addEventListener('change', function () {
        if (this.files.length > 2){
            alert('You can only select 2 files');
            console.log(this.files);
            document.getElementById('uploadFile').reset();
        }
    });

    /**
 * Function to display search results in a table.
 * @param {Array} cids - List of PubChem Compound IDs.
 * @param {HTMLElement} container - Container to display the search results.
 */
 function displaySearchResults(cids, container) {
    if (cids.length === 0) {
        container.innerHTML = `<p class="text-danger p-2">No results found</p>`;
    } else {
        container.innerHTML = ``;

        const searchResultTable = document.createElement('table');
        searchResultTable.classList = 'table text-white mb-0';
        container.appendChild(searchResultTable);

        const tableBody = document.createElement('tbody');
        searchResultTable.appendChild(tableBody);

        // Use Promise.all to wait for all details to be fetched before updating the table
        Promise.all(cids.map(cid => getPubChemCompoundDetails(cid)))
            .then(detailsList => {
                detailsList.forEach(compoundDetails => {
                    const row = tableBody.insertRow();
                    const cell1 = row.insertCell(0);
                    const cell2 = row.insertCell(1);

                    cell1.classList.add('text-break');
                    cell1.innerHTML = `${compoundDetails.name}<br>${compoundDetails.formula}<br>PubChem ID: ${compoundDetails.pubChemId}`;

                    let addButton = document.createElement('button');
                    addButton.classList = 'btn btn-outline-light btn-block';
                    addButton.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16"><path d="M8 0a1 1 0 0 1 1 1v6h6a1 1 0 0 1 0 2H9v6a1 1 0 0 1 1-1zm0 0a1 1 0 0 1 1 1v6h6a1 1 0 0 1 0 2H9v6a1 1 0 0 1-2 0V9H1a1 1 0 0 1 0-2h6V1a1 1 0 0 1 1-1z"/></svg> Add Molecule`;

                    addButton.addEventListener("click", function (event) {
                        event.preventDefault();
                        const cid = compoundDetails.pubChemId;

                        fetch(`/addModel/saveModelFile`, {
                            method: 'POST',
                            headers: {
                                'Content-type': 'application/json'
                            },
                            body: JSON.stringify({
                                pubchemId: cid,
                                name: compoundDetails.name,
                                formula: compoundDetails.formula
                            })
                        }).then(response => {
                            if (!response.ok){
                                throw new Error('Failed to add molecule')
                            };
                        })
                        //addToFirebase(compoundDetails.name, compoundDetails.formula, compoundDetails.pubChemId);
                    });

                    cell2.appendChild(addButton);
                    cell2.classList = 'w-25';
                });
            })
            .catch(error => {
                console.error("Error:", error);
            });
    }
}

</script>
