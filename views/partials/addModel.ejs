<style>
    .btn-green {
        background-color: #097242;
        color: white;
    }

    .btn-green:hover {
        background-color: #075c33;
        color: white;
    }

    .btn-customsubmit {
        background-color: #0071EB;
        color: white;
    }

    .btn-customsubmit:hover {
        background-color: #005bb5;
        color: white;
    }
</style>

<!-- Add Model -->
<div class="row content">
    <div class="col-12 text-start text-white main-background-color">
        <div>
            <button class="btn btn-green" type="button" data-bs-toggle="collapse" data-bs-target="#uploadFile"
                aria-expanded="false" aria-controls="uploadFile">
                Upload File 
            </button>
        </div>
    </div>

    <div class="row">
        <form class="collapse multi-collapse" id="uploadFile" enctype="multipart/form-data">
            <div class="row d-flex flex-wrap">
                <div class="col-12 col-sm-6 d-flex flex-wrap">
                    <h4>Model name:</h4>
                    <input type="text" class="form-control" id="modelName" name="name" placeholder="Ex: molecule_diagramName_number" required>
                    
                    <h4>Description:</h4>
                    <input type="text" class="form-control" id="modelDescription" name="modelDescription" placeholder="Model description" required>

                    <h4>Select File Type:</h4>
                    <select class="form-control" id="fileType" name="fileType">
                        <option value="obj-mtl">OBJ + MTL</option>
                        <option value="gltf">GLTF</option>
                        <option value="glb">GLB</option>
                    </select>

                    <!-- OBJ + MTL Files -->
                    <div id="objMtlUpload">
                        <h4>Files (.obj and .mtl):</h4>
                        <input type="file" class="form-control" id="objFileName" name="objFileName" required accept=".obj">
                        <input type="file" class="form-control" id="mtlFileName" name="mtlFileName" required accept=".mtl">
                    </div>

                    <!-- GLTF File -->
                    <div id="gltfUpload" style="display: none;">
                        <h4>File (.gltf):</h4>
                        <input type="file" class="form-control" id="gltfFileName" name="gltfFileName" accept=".gltf">
                    </div>

                    <!-- GLB File -->
                    <div id="glbUpload" style="display: none;">
                        <h4>File (.glb):</h4>
                        <input type="file" class="form-control" id="glbFileName" name="glbFileName" accept=".glb">
                    </div>

                    <button class="btn btn-customsubmit form-control my-2" id="uploadBtn">
                        <span id="uploadBtnSpinner" class="spinner-border spinner-border-sm" role="status" aria-label="Loading" style="display: none;"></span>
                        Upload
                    </button>
                </div>
                <div class="col-12 col-sm-6 d-flex align-content-stretch flex-wrap">
                    <textarea class="form-control" name="preview" id="preview" style="display: none"></textarea>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="module">
    const uploadModelForm = document.getElementById('uploadFile');
    const fileTypeSelector = document.getElementById('fileType');
    const objMtlUpload = document.getElementById('objMtlUpload');
    const gltfUpload = document.getElementById('gltfUpload');
    const objInput = document.getElementById('objFileName');
    const mtlInput = document.getElementById('mtlFileName');
    const gltfInput = document.getElementById('gltfFileName');
    const glbInput = document.getElementById('glbFileName');

    fileTypeSelector.addEventListener('change', function () {
        if (this.value === 'obj-mtl') {
            objMtlUpload.style.display = 'block';
            gltfUpload.style.display = 'none';
            glbUpload.style.display = 'none';

            objInput.required = true;
            mtlInput.required = true;
            gltfInput.required = false;
            glbInput.required = false;
        } else if(this.value === 'gltf'){
            objMtlUpload.style.display = 'none';
            gltfUpload.style.display = 'block';
            glbUpload.style.display = 'none';

            objInput.required = false;
            mtlInput.required = false;
            gltfInput.required = true;
            glbInput.required = false;
        }else{
            objMtlUpload.style.display = 'none';
            gltfUpload.style.display = 'none';
            glbUpload.style.display = 'block';

            objInput.required = false;
            mtlInput.required = false;
            gltfInput.required = false;
            glbInput.required = true;
        }
    });

    uploadModelForm.addEventListener('submit', e => {
        e.preventDefault();
        setModelUploading(true);

        const formData = new FormData(uploadModelForm);
        fetch('/addmodel/saveModel', {
            method: 'POST',
            body: formData
        })
        .then(async res => {
            const body = await res.json().catch(() => ({}));
            if (!res.ok) {
                throw new Error(body.error || `Server returned status code ${res.status}`);
            }
            toastr.success(body.message);
            uploadModelForm.reset();
            fetchModels(); // fetchModels is defined at views/models.ejs
        })
        .catch(err => {
            toastr.error(err.message, "Failed to save model");
        })
        .finally(() => setModelUploading(false));
    });

    function setModelUploading(isUploading) {
        const spinner = document.getElementById('uploadBtnSpinner');
        const uploadBtn = document.getElementById('uploadBtn');

        spinner.style.display = isUploading ? '' : 'none';
        uploadBtn.disabled = isUploading;
    }
</script>

