<!-- Add Model -->
<div class="row content">
    <div class="col-12 text-start text-white bg-dark">
        <div>
            <button class="btn btn-outline-success" type="button" data-bs-toggle="collapse" data-bs-target="#uploadFile"
                aria-expanded="false" aria-controls="uploadFile">
                Upload File 
            </button>
        </div>
    </div>

    <div class="row">
        <form class=" collapse multi-collapse" id="uploadFile" enctype="multipart/form-data">
            <div class="row d-flex flex-wrap">
                <div class="col-12 col-sm-6 d-flex  flex-wrap">
                    <h4>Model name:</h4>
                    <input type="text" class="form-control" id="modelName" name="name" placeholder="Ex: molecule_diagramName_number"  required>
                    <h4>Description:</h4>
                    <input type="text" class="form-control" id="modelDescription" name="modelDescription" placeholder="Model description" required>
                    <h4>Files (.obj and .mtl):</h4>
                    <input type="file" class="form-control" id="objFileName" name="objFileName" placeholder="File name" onchange="" 
                    required accept=".obj">
                    <input type="file" class="form-control" id="mtlFileName" name="mtlFileName" placeholder="File name" onchange="" 
                    required accept=".mtl">
                    <button class="btn btn-success form-control my-2" id="uploadBtn">
                        <span
                            id="uploadBtnSpinner"
                            class="spinner-border spinner-border-sm"
                            role="status"
                            aria-label="Loading"
                            style="display: none;"
                        ></span>
                        Upload
                    </button>
                </div>
                <div class="col-12 col-sm-6 d-flex align-content-stretch flex-wrap">
                    <textarea class="form-control" name="preview" id="preview" style="display: none"></textarea>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="module">
    const uploadModelForm = document.getElementById('uploadFile');
    uploadModelForm.addEventListener('submit', e => {
        e.preventDefault();
        setUploading(true);

        const formData = new FormData(uploadModelForm);
        fetch('/addmodel/saveModel', {
            method: 'POST',
            body: formData
        })
            .then(async res => {
                const body = await res.json();
                if (res.status === 400 && body.error) {
                    throw new Error(body.error);
                } else if (!res.ok) {
                    throw new Error(`Server returned status code ${res.status}`);
                }

                toastr.success(body.message);
                uploadModelForm.reset();
                fetchModels();   // fetchModels is defined at views/models.ejs
            })
            .catch(err => {
                toastr.error(err.message, "Failed to save model");
            })
            .finally(() => setUploading(false));
    });

    function setUploading(isUploading) {
        const spinner = document.getElementById('uploadBtnSpinner');
        const uploadBtn = document.getElementById('uploadBtn');

        if (isUploading) {
            spinner.style.display = '';
            uploadBtn.disabled = true;
        } else {
            spinner.style.display = 'none';
            uploadBtn.disabled = false;
        }
    }
</script>
