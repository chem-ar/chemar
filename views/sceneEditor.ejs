        if (pngFileName) {
            pngFileToUpdate = pngFileName;
        }

        const { markerData, sceneMolecules } = exportSceneData();

        scene = {
            "name": sceneName,
            "desc": sceneDescription,
            "png": pngFileToUpdate,
            "trackingMarker": markerData,
            "molecules": sceneMolecules,
        }

        // Update scene catalog file
        fetch(`/sceneEditor/save/${scene.name}`, {
            method: "POST",
            headers: {
                'Content-Type': "application/json"
            },
            body: JSON.stringify(scene)
        })
        .then(response => response.json())
        .then(data => {
            console.log(data); // log the response data to the console
            updateSceneCatalog(scene.name, sceneName, sceneDescription);
            updateScenesList(); // Call the function to update the scenes list
        })
        .catch(err => {
            console.error(err)
        });
        // Close the modal
        var saveModal = new bootstrap.Modal(document.getElementById('saveModal'));
        saveModal.hide();

        // Redirect the user to the scenes page
        window.location.href = "/scenes";
    }
});

function updateSceneCatalog(oldSceneName, newSceneName, newSceneDescription) {
    fetch(`/sceneEditor/updateCatalog/${oldSceneName}`, {
        method: "POST",
        headers: {
            'Content-Type': "application/json"
        },
        body: JSON.stringify({
            name: newSceneName,
            description: newSceneDescription
        })
    })
    .then(response => response.json())
    .then(data => {
        console.log(data); // Log the response data to the console
    })
    .catch(err => {
        console.error(err);
    });
}

function updateScenesList() {
    fetch('https://localhost:4000/scenes/list')
