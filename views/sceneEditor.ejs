    <script type= "module">
        import { createModel} from '/js/scenes/rendering.js';
        import {
            initScene,
            addModelToScene,
            onMarkerXChange,
            onMarkerYChange,
            updateSceneImg,
            exportSceneData
        } from '/js/scenes/scene-mgmt.js';
        import { addMolToMenu } from '/js/scenes/add-mol-to-menu.js';

        var fileName = document.getElementById("fileName");
        var sceneName = document.getElementById("sceneName");
        var sceneDescription = document.getElementById("sceneDescription");
        const moleculeList = document.getElementById('molecule-list');
        const threeArea = document.getElementById('three-area');

        const markerXSlider = document.getElementById('markerXSlider');
        const markerXInput = document.getElementById('markerXInput');
        const markerYSlider = document.getElementById('markerYSlider');
        const markerYInput = document.getElementById('markerYInput');

        let scene;
        let markerData;

        let requestedFile = window.location.pathname.substring(window.location.pathname.lastIndexOf('/') + 1);

        fetch('/scenes' + '/' + requestedFile)
            .then(response => response.json())
            .then(async data => {
                scene = data;
                
                fileName.innerHTML = "File name: " + requestedFile;
                sceneName.innerHTML = "Scene name: " + scene.name;
                sceneDescription.innerHTML = "Scene desc: " + scene.desc;
                markerData = scene.trackingMarker
               
                initScene(scene.png, markerData, threeArea, window);
                
                markerXSlider.value = markerData.position.x;
                markerXInput.value = markerData.position.x;
                markerYSlider.value = markerData.position.y;
                markerYInput.value = markerData.position.y;

                // Draw each molecule in three when sceneEditor is loaded.
                for(let item of scene.molecules) {
                    
                    const modelInfo = item.modelInfo;
                    const model = await createModel(modelInfo, item.position, item.rotation, item.scale);
                    
                    addModelToScene(modelInfo, model, item.cjson);
                    addMolToMenu(model, modelInfo.name, moleculeList);
                }
            })
            .catch(error => console.error(error));


            function validateName() {
                const nameInput = document.getElementById("newNameInput").value;
                const descriptionInput = document.getElementById("newDescriptionInput").value;

                if (nameInput.trim() === "" || descriptionInput.trim() === "") {
                    return false;
                }
                
                return true;
            }

        var scenesListMenu = document.getElementById("sceneMenuList");
        fetch('/scenes/list')
            .then(response => response.json())
            .then(data => {
                const scenesList = data;

                scenesList.map(scene => {
                    const newOption = document.createElement("option");
                    newOption.value = scene;
                    newOption.text = scene.replace('.json', '');
                    scenesListMenu.appendChild(newOption);
                });
            })
            .catch(error => console.error(error));
        
        document.addEventListener("DOMContentLoaded", function () {
            const searchField = document.getElementById("search-field");
            const searchButton = document.getElementById("search-button");

            searchButton.addEventListener("click", function (event) {
                event.preventDefault();
                searchModel(searchField.value);
            });    

            searchField.addEventListener("keypress", function(event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    searchButton.click();
                    }
                });
        });

        async function searchModel(userQuery){
            const trimmedQuery = userQuery.trim();

            if(trimmedQuery === "") {
                displaySearchResults([]);
                return;
            }
            const encodedUserQuery = encodeURIComponent(trimmedQuery);
            const searchResponse = await fetch(`/models/searchModels?search=${encodedUserQuery}`);
            const searchResults = await searchResponse.json();
            displaySearchResults(searchResults);
        }

        function displaySearchResults(models) {
            const searchResults = document.getElementById("search-results");
            searchResults.innerHTML = '';

            if (models.length === 0) {
                searchResults.innerHTML = '<p class="text-danger p-2">No results found</p>';
                return;
            }
            
            models.forEach(modelInfo => {
                const rowDiv = document.createElement('div');
                rowDiv.classList = "row g-3 mt-1";

                const nameDiv = document.createElement('div');
                nameDiv.classList = "col-8";
                nameDiv.innerText = modelInfo.name;

                const btnDiv = document.createElement('div');
                btnDiv.classList = "col-4";

                const addModelBtn = document.createElement('button');
                addModelBtn.classList = "btn btn-outline-light";
                addModelBtn.innerText = "Add to scene";
                addModelBtn.type = 'button';
                addModelBtn.addEventListener('click', async e => {
                    const spinner = document.createElement('span');
                    spinner.classList = "spinner-border";
                    spinner.role = "status";
                    spinner.ariaLabel = "Loading";
                    const lineBreak = document.createElement('br');

                    e.target.prepend(spinner, lineBreak);
                    e.target.disabled = true;

                    const createdModel = await createModel(modelInfo)
                        .finally(() => { 
                            e.target.removeChild(spinner);
                            e.target.removeChild(lineBreak);
                            e.target.disabled = false;
                        });

                    addModelToScene(modelInfo, createdModel);
                    addMolToMenu(createdModel, modelInfo.name, moleculeList);
                });

                btnDiv.appendChild(addModelBtn);
                rowDiv.appendChild(nameDiv);
                rowDiv.appendChild(btnDiv);

                searchResults.appendChild(rowDiv);
            })
        }

        let offcanvas = document.getElementById('mainMenu')
        offcanvas.classList.add('show')

        markerXSlider.addEventListener('input', onMarkerXChange);
        markerXInput.addEventListener('input', onMarkerXChange);
        markerYSlider.addEventListener('input', onMarkerYChange);
        markerYInput.addEventListener('input', onMarkerYChange);

        var loadedScene = {};

        document.getElementById('loadSaveBtn').addEventListener('click', () => {
            var selectedScene = document.getElementById("sceneMenuList").value;

            fetch(`/scenes/${selectedScene}`)
                .then(response => response.json())
                .then(data => {
                    loadedScene = JSON.stringify(data);
                    console.log(loadedScene);
                });
        });

        document.getElementById('loadNoSaveBtn').addEventListener('click', () => {
            console.log("No save and loaded.");
        });

        let sceneNameInput = document.getElementById('newNameInput');
        let sceneDescriptionInput = document.getElementById('newDescriptionInput');

// When the admin saves changes to the scene editor.
document.getElementById("saveBtn").addEventListener('click', () => {
    if (!validateName()) {
        alert("Please enter a name and description");
    } else {

        var sceneName = sceneNameInput.value;
        var sceneDescription = sceneDescriptionInput.value;

