        const sceneFileInput = document.getElementById('sceneFileInput');
        let pngFileName;

        sceneFileInput.addEventListener('change', function(e) {
            const file = sceneFileInput.files[0];

            // Extract the PNG file name
            pngFileName = file.name;

            const reader = new FileReader();
            reader.addEventListener("load", () => {
                // convert image file to base64 string
                var xhr = new XMLHttpRequest();
                xhr.open('POST', './upload/images', true);
                xhr.setRequestHeader('Content-Type', 'application/json');
                xhr.onload = function() {
                    if (xhr.status === 200) {
                        let response = JSON.parse(xhr.responseText);
                        if (response.success) {
                            updateSceneImg(response.fileSrc);
                        } else {
                            alert('Error: ' + response.message);
                        }
                    } else {
                        alert('Error: ' + xhr.status);
                    }
                };
                xhr.send(JSON.stringify({
                    "image-name": pngFileName,
                    "image-contents": reader.result
                }));
            }, false);

            if (file) {
                reader.readAsDataURL(file);
            }
        });
    </script>

