<%- include('partials/header') %>
<!--ADMIN NAVBAR CHECK-->
<% if (isAdmin){%>
    <%- include('partials/navbarAdmin') %>
<%}%>
<% if (!isAdmin){%>
    <%- include('partials/navbar') %>
<%}%>
<script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

<div class="container mb-4 main-background-color">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white">
            <h1 class="display-4 fw-bold">Model Catalog</h1>
            <!--ADMIN CHECK-->
            <% if (isAdmin){%>
                <%- include('partials/addModel') %>
            <%}%>
            <p></p>
            <table id="modelTable" class="table table-striped text-white" style="width:100%">
                <thead>
                    <tr>
                        <th class="modeltable-header">Name</th>
                        <th class="modeltable-header">Description</th>
                        <th class="modeltable-header">Obj File</th>
                        <th class="modeltable-header">Mtl File</th>
                        <!-- If the user is an admin, include the Options column -->
                        <% if (isAdmin){%>
                            <th class="options-column modeltable-header">Options</th>
                        <%}%>
                    </tr>
                </thead>            
                <tbody id="table-body">
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="editModalLabel">Edit Model</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-12 text-start text-white bg-dark">
                    <form id="editModelForm" action="/" method="PUT">
                        <div class="row">
                            <div class="col-12 col-sm-12 col-md-12">
                                <h4 class="mb-1 mt-2">Model Name:</h4>
                                <input type="text" class="form-control" id="modelNameEdit" name="name" placeholder="Model Name" required>
                                <h4 class="mb-1 mt-2">Description:</h4>
                                <input type="text" class="form-control" id="modelDescriptionEdit" name="description" placeholder="Description" required>
                                <button type="submit" id="editSubmitBtn" class="btn btn-success form-control my-2">Submit</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this model?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger" data-bs-dismiss="modal">Delete</button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-content .modal-body {
        color: white;
    }
</style>

<script>
    $(document).ready(function () {
        $('#editModal').appendTo("body");
        $('#deleteModal').appendTo("body");

        // Initialize the DataTable
        dataTable = new DataTable('#modelTable', {
            ordering: true
        });
        
        fetchModels();
    });

    let dataTable;

    // this function is also used at views/partials/addModel.ejs
    function fetchModels() {
        // Fetch the model data from the server
        fetch("/catalog/modelFileCatalog.json")
            .then((res) => {
                if (!res.ok) {
                    throw new Error(`HTTP error Status: ${res.status}`);
                }
                return res.json();
            })
            .then((modelData) => {
                dataTable.clear();

                // Populate the table with the fetched model data
                for (const key in modelData) {
                    populateTable(modelData[key]);
                }

                // event listeners for the edit and delete buttons
                document.querySelectorAll('.editModelBtn').forEach(btn => {
                    btn.addEventListener('click', handleEditClick);
                });

                document.querySelectorAll('.deleteModelBtn').forEach(btn => {
                    btn.addEventListener('click', handleDeleteClick);
                });

            })
            .catch((error) => toastr.error(error.message, "Unable to fetch data"));
    }
    
    //To handle edit button functionality    
    function handleEditClick(event){
        const btn = event.currentTarget;
        const row = btn.closest('tr');
        const modelName = row.children[0].textContent;
        const modelDescription = row.children[1].textContent;
        const modelFile = btn.getAttribute('data-file');
        const id = btn.id;

        document.getElementById('modelNameEdit').value = modelName;
        document.getElementById('modelDescriptionEdit').value = modelDescription;

        // handle form submission
        document.getElementById('editModelForm').onsubmit = function (e) {
            e.preventDefault();
            const updatedModel = {
                name: document.getElementById('modelNameEdit').value,
                description: document.getElementById('modelDescriptionEdit').value
            };
            //fetch request made to update using POST method
            fetch(`/models/edit?id=${id}`, {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(updatedModel)
            }).then(response => {
                if (response.ok) {
                    $('#editModal').modal('hide')
                    toastr.success('Edited Successfuly')
                    fetchModels();
                }else if(response.status == 409){
                    $('#editModal').modal('hide')
                    toastr.error('Model with same name & description exist')
                    fetchModels();
                }else if(response.status == 401){
                    $('#editModal').modal('hide')
                    toastr.error('Please Login to edit')
                }else {
                    throw new Error("Server returned status code: " + response.status)
                }
                //catch used to catch any errors
            }).catch(error =>{
                console.error("Error:", error)
                toastr.error('Error in Editing, please try again!');
            });  
        }
    }
    //Delete button functionality
    function handleDeleteClick(event) {
        const btn = event.currentTarget;
        const row = btn.closest('tr');
        const id = btn.id;
        const modelFile = btn.getAttribute('data-file');

        document.getElementById('confirmDeleteBtn').onclick = function () {
            //Fetch request made to delete the model
            fetch(`/models/delete?id=${id}`, {
                method: "GET"
            }).then(response => {
                if (response.ok) {
                    $('#deleteModal').modal('hide')
                    toastr.success('Deleted Successfully')
                    fetchModels();
                }else if(response.status == 401){
                    $('#deleteModal').modal('hide')
                    toastr.error('Please Login to delete')
                }else {
                    console.error("Failed to delete model.");
                    toastr.error('Delete Unsuccessfull')
                    fetchModels();
                }
            }).catch(error =>{
                console.error("Error:", error)
                toastr.error('Error in deleting, please try again!');
            });  
        }
    }

    //To populate data to the table
    function populateTable(modelData) {
        const newRow = dataTable.row.add([ modelData.name,
            modelData.description,
            '<a class="text-white modelfiles-in-table" id="Name" href="modelfiles/' +  modelData.files.obj + '">' + modelData.files.obj + '</a>',
            '<a class="text-white modelfiles-in-table" id="Name" href="modelfiles/' +  modelData.files.mtl +'">' + modelData.files.mtl + '</a>',
            <% if (isAdmin){%>
            `<td class class="options-column">
                                <div class=" d-grid gap-2">
                                    <button type="button" id=${modelData.id} onclick="${(e) => handleEditClick(e, modelData.id)}" class="btn editModelBtn" style="background-color: #FFB300; color: black;" data-bs-toggle="modal" data-bs-target="#editModal">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16" aria-label="Edit icon">
                                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                        </svg> Edit
                                    </button>
                                    <button type="button" class="btn deleteModelBtn" style="background-color: #CC0000; color: white;" id=${modelData.id} data-bs-toggle="modal" data-bs-target="#deleteModal" data-file="">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16" aria-label="Delete icon">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                            <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                        </svg> Delete
                                    </button>
                                </div>
                            </td>`
            <%}%>
        ]).draw().node();

    }

</script>

<%- include('partials/footer')%>