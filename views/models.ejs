<%- include('partials/header') %>
<% if (isOwner) { %>
    <%- include('partials/navbarowner') %>
<% } else if (isInstructor || isAdmin) { %>
    <%- include('partials/navbarAdmin') %>
<% } else { %>
    <%- include('partials/navbar') %>
<% } %>

<div class="container mb-4 main-background-color">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white">
            <h1 class="display-4 fw-bold">Model Catalog</h1>
            <% if (isAdmin || isInstructor || isOwner){%>
                <%- include('partials/addModel') %>
            <%}%>
            <table id="modelTable" class="table table-striped text-white" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>File Name</th>
                        <% if (isAdmin || isInstructor || isOwner){%>
                            <th class="options-column">Options</th>
                        <%}%>
                    </tr>
                </thead>            
                <tbody>
                    <% models.forEach(model => { %>
                        <tr>
                            <td><%= model.file_name %></td>
                            <td><%= model.desc %></td>
                            <td><%= model.file_name_only %></td>
                            <% if (isAdmin || isInstructor || isOwner) { %>
                                <td>
                                    <button type="button" class="btn editModelBtn btn-warning" data-id="<%= model.id %>" data-name="<%= model.file_name %>" data-desc="<%= model.desc %>" data-bs-toggle="modal" data-bs-target="#editModal">Edit</button>
                                    <button type="button" class="btn deleteModelBtn btn-danger" data-id="<%= model.id %>" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</button>
                                </td>
                            <% } %>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="editModalLabel">Edit Model</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editModelForm">
                    <input type="hidden" id="editModelId">
                    <div class="mb-3">
                        <label for="modelNameEdit" class="form-label text-white">Model Name:</label>
                        <input type="text" class="form-control" id="modelNameEdit" name="name" required>
                    </div>
                    <div class="mb-3">
                        <label for="modelDescriptionEdit" class="form-label text-white">Description:</label>
                        <input type="text" class="form-control" id="modelDescriptionEdit" name="description" required>
                    </div>
                    <button type="submit" class="btn btn-success form-control my-2">Submit</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-white">
                Are you sure you want to delete this model?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.editModelBtn').forEach(button => {
        button.addEventListener('click', () => {
            document.getElementById('editModelId').value = button.getAttribute('data-id');
            document.getElementById('modelNameEdit').value = button.getAttribute('data-name');
            document.getElementById('modelDescriptionEdit').value = button.getAttribute('data-desc');
        });
    });

    document.getElementById('editModelForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const id = document.getElementById('editModelId').value;
        const name = document.getElementById('modelNameEdit').value;
        const description = document.getElementById('modelDescriptionEdit').value;

        try {
            const res = await fetch(`/models/edit`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id, name, description })
            });
            if (res.ok) {
                location.reload();
            } else if (res.status === 409) {
                toastr.error("Duplicate model name and description.");
            } else {
                toastr.error("Edit failed.");
            }
        } catch (err) {
            toastr.error("Error editing model.");
        }
    });

    let deleteId = null;
    document.querySelectorAll('.deleteModelBtn').forEach(button => {
        button.addEventListener('click', () => {
            deleteId = button.getAttribute('data-id');
        });
    });

    document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
        if (!deleteId) return;
        try {
            const res = await fetch('/models/delete', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: deleteId })
            });
            if (res.ok) {
                location.reload();
            } else {
                toastr.error("Delete failed.");
            }
        } catch (err) {
            toastr.error("Error deleting model.");
        }
    });
</script>

<%- include('partials/footer') %>
