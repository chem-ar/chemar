<%- include('partials/header') %>
<!--ADMIN NAVBAR CHECK-->
<% if (isAdmin){%>
    <%- include('partials/navbarAdmin') %>
<%}%>
<% if (!isAdmin){%>
    <%- include('partials/navbar') %>
<%}%>
<script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

<div class="container mb-4">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white bg-dark">
            <h1 class="display-4 fw-bold">Model Catalog</h1>
            <!--ADMIN CHECK-->
            <% if (isAdmin){%>
                <%- include('partials/addModel') %>
            <%}%>               
            <p></p>
            <table id="modelTable" class="table table-striped text-white" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Mtl File</th>
                        <th>Obj File</th>
                        <% if (isAdmin){%><th>Options</th><%}%>
                    </tr>
                </thead>       
                <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
                <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
                <script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
                <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">

                  <script>
                    

                    fetch("/catalog/modelfileCatalog.json")
                                                .then((res) => {
                                                    if (!res.ok) {
                                                        throw new Error
                                                            (`HTTP error! Status: ${res.status}`);
                                                    }
                                                    return res.json();
                                                })
                                                .then((modelData) => {
                                                    $(document).ready(function () {
                                                     $('#modelTable').DataTable({
                                                            });
                                                     });
                                                    for (const key in modelData) {
                                                                populateTable(modelData[key]);
                                                    }
                                                })   
                                                .catch((error) => 
                                                    console.error("Unable to fetch data:", error));   
                                                    
                                        function populateTable(modelData){
                                            const tableBody = document.getElementById('table-body');

                                                const row = document.createElement('tr');
                                            
                                                    row.innerHTML = `
                                                                <td>${modelData.name}</td>
                                                                <td>${modelData.description}</td>
                                                                <td><a class="text-white" id="Name" href=""> ${modelData.files.obj}</a></td>
                                                                <td><a class="text-white" id="Name" href=""> ${modelData.files.mtl}</a></td>
                                                            `;
                                            tableBody.appendChild(row);
                                            
                                        }

                </script>
                <tbody id="table-body">
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

