<%- include('partials/header') %>
    <%- include('partials/navbar') %>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
            crossorigin="anonymous"></script>

        <section class="vh-80 gradient-custom">
            <div class="container py-5 h-100">
                <div class="row d-flex justify-content-center align-items-center h-100">
                    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                        <div class="card bg-secondary text-white" style="border-radius: 1rem">
                            <div class="card-body p-5 text-center">
                                <div class="mb-md-5 mt-md-4 pb-5">
                                    <br><br><br>
                                    <h1 class="fw-bold mb-2">Forgot Password</h1>
                                    <h4 class="mb-5">Please enter your new password</h4>

                                    <!--Form-->
                                    <form id="passwordForm" action="" method="post">
                                        <div class="form-outline form-white mb-4">
                                            <input type="password" id="newPassword" class="form-control form-control-lg"
                                                name="newPassword" placeholder="New Password:"
                                                onkeyup="checkPasswordStrength()"><br>

                                            <small class="text-bright-white">Password Requirements:</small>
                                            <ul class="text-bright-white small mb-0">
                                                <li>At least 7 characters long</li>
                                                <li>At least one uppercase letter</li>
                                                <li>At least one lowercase letter</li>
                                                <li>At least one number</li>
                                                <li>At least one symbol (@!$%*?&)</li>
                                            </ul>
                                            <div id="passwordFeedback" class="text-danger"></div>
                                            <br>

                                            <input type="password" id="confirmNewPassword"
                                                class="form-control form-control-lg" name="confirmNewPassword"
                                                placeholder="Confirm New Password:" onkeyup="checkPassword()">
                                            <div id="passwordMatch" class="text-danger"></div>

                                        </div>


                                        <button class="btn btn-outline-light btn-lg px-5"
                                            onsubmit="submitPassword(event)" type="submit">
                                            Save New Password
                                        </button>
                                        <br>

                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <script>
            const confirmedNewPasswordInput = document.getElementById('confirmNewPassword');
            const newPasswordInput = document.getElementById('newPassword');
            const passwordFeedback = document.getElementById('passwordFeedback');
            const passwordMatch = document.getElementById('passwordMatch');

            // Check if passwords match
            function checkPassword(e) {
                var newPassword = newPasswordInput.value;
                var confirmedNewPassword = confirmedNewPasswordInput.value;

                if (newPassword == confirmedNewPassword) {

                    confirmedNewPasswordInput.style.backgroundColor = '#b3ffb3';
                    passwordMatch.textContent = 'Password Match';
                    newPasswordInput.style.backgroundColor = '#b3ffb3';
                    passwordMatch.classList.remove("text-danger")
                    passwordMatch.classList.add("text-sucess")
                    passwordMatch.style.color = '#b3ffb3';
                } else {
                    confirmedNewPasswordInput.style.backgroundColor = '#ff9980';
                    passwordMatch.textContent = "Password doesn't Match";
                    newPasswordInput.style.backgroundColor = '#ff9980';
                    passwordMatch.classList.remove("text-sucess")
                    passwordMatch.classList.add("text-danger")
                    passwordMatch.style.color = '#ff9980';

                }
            }

            function checkPasswordStrength() {
                var newPassword = newPasswordInput.value;
                var strength = validatePassword(newPassword);

                if (strength) {
                    newPasswordInput.style.backgroundColor = '#b3ffb3';
                    passwordFeedback.textContent = 'Strong Password';
                    passwordFeedback.style.color = '#b3ffb3';
                    passwordFeedback.classList.remove("text-danger")
                    passwordFeedback.classList.add("text-sucess")
                } else {
                    newPasswordInput.style.backgroundColor = '#ff9980';
                    passwordFeedback.textContent = 'Weak Password';
                    passwordFeedback.style.color = '#ff9980';
                    passwordFeedback.classList.remove("text-sucess")
                    passwordFeedback.classList.add("text-danger")


                }
            }

            function validatePassword(password) {
                const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@#$%^&*!])[A-Za-z\d@#$%^&*!]{7,}$/;
                return regex.test(password);
            }
            function submitPassword(event) {
                event.preventDefault(); // Prevent default form submission
                const email = req.body.email;


                fetch(`/passwordReset`, {
                    method: "Post",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ newPassword: newPasswordInput })
                })
                    .then(async response => {
                        const body = await response.json().catch(_error => ({}));

                        if (response.status === 401 && body.error) {
                            throw new Error(body.error);
                        } else if (!response.ok) {
                            throw new Error(`Server returned status code ${response.status}`);
                        }


                        window.location = "/";
                    })
                    .catch(error => {
                        console.log(error);

                    });
            } 
        </script>
        <footer>
            <%- include('partials/footer') %>
        </footer>
        </body>

        </html>