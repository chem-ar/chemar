<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.3/css/dataTables.bootstrap5.min.css">
    <title>ChemAR</title>

    <style>
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            color: white;
            background: #202020;
        }

        .content {
            border: 2px solid #333;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .content-display {
            border: 2px solid #333;
            padding: 20px;
            margin-bottom: 20px;
        }

        .content-jsmol {

            border: 2px solid #333;
            padding: 20px;
            margin-bottom: 20px;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        #control-panel {
            display: flex;
            justify-content: center;
            padding: 20px;
            align-items: center;
            border: 2px solid #333;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        input[type=button] {
            background-color: rgb(251, 251, 251);
            border-radius: 4px;
            border: 2px solid #333;
        }
    </style>

</head>

<body>
    <script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-database-compat.js"></script>
    <script src="/jmol-16.1.41/jsmol/JSmol.min.js"></script>
    <script src="/jmol-16.1.41/jsmol/js/Jmol2.js"></script>

    <script>
        const currentURL = window.location.href;
        const urlParts = currentURL.split('/');
        const cid = urlParts[urlParts.length - 1];

        console.log("CID:", cid);

        const url = `https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/cid/${cid}/record/SDF/?record_type=3d&response_type=display`;

        const firebaseConfig = {
            databaseURL: "https://chemar-5845a-default-rtdb.firebaseio.com/",
        };

        Jmol.Info.j2sPath = '/jmol-16.1.41/jsmol/j2s';
        Jmol.Info.serverURL = '/jmol-16.1.41/jsmol/php/jsmol.php';
        jmolInitialize('/jmol-16.1.41/jsmol', true);

        let extractedData;

        function fetchData() {
            const xhr = new XMLHttpRequest();
            xhr.open('GET', url, false);
            xhr.send();

            if (xhr.status === 200) {
                extractedData = xhr.responseText.substring(0, xhr.responseText.indexOf("END")).trim();
                extractedData = '|' + extractedData.replace(/\n/g, '|').replace(/\r/g, '') + 'END|';
                return Promise.resolve(extractedData);
            } else {
                return Promise.reject(new Error("Something went wrong"));
            }
        }

        fetchData()
            .then(data => {
                console.log(data);
                jmolSetAppletColor('0x202020');
                jmolApplet(['600', '600'], "set antialiasdisplay\;load data \"mydata\"" + data + "$$$$||end \"mydata\";spin on;background HOVER[NONE];", '0');
            })
            .catch(error => {
                console.error(error);
            });

        firebase.initializeApp(firebaseConfig);
        async function initializeFirebase() {
            const keysArray = [];
            let objPresent = false;

            const database = firebase.database();

            const objRef = database.ref("obj");

            const snapshot = await objRef.once("value");
            const data = snapshot.val();
            keysArray.push(...Object.keys(data));
            console.log(keysArray);
            if (keysArray.includes(cid)) {
                objPresent = true;
                const objRef = database.ref("obj");
                objRef.child(cid).once("value", function (snapshot) {
                    const data = snapshot.val();
                    console.log(data);
                });
            }
            else {
                let extractedData;
                const xhr = new XMLHttpRequest();
                xhr.open('GET', url, false);
                xhr.send();
                if (xhr.status === 200) {
                    extractedData = xhr.responseText.substring(0, xhr.responseText.indexOf("END")).trim();
                    extractedData = '|' + extractedData.replace(/\n/g, '|').replace(/\r/g, '') + 'END|';
                    const objRef = database.ref("obj");
                    objRef.child(cid).set(extractedData);
                    objPresent = true;
                } else {
                    return Promise.reject(new Error("Something went wrong"));
                }
            }
            console.log({ objPresent });
        }
        initializeFirebase();
      
        jmolButton("spin @ {!_spinning}", "Toggle Spin")

        // Create a slider element
        var slider = document.createElement("input");
        //add title for the slider
        var title = document.createElement("h5");
        title.innerHTML = "Van der Waals Radius";
        document.body.appendChild(title);
        slider.type = "range";
        slider.min = 0.2; // Minimum value for van der Waals radius
        slider.max = 2.0; // Maximum value for van der Waals radius
        slider.step = 0.1; // Step size for slider
        slider.value = 0.3; // Default value for slider

        // Create a label element to show the current value
        var label = document.createElement("span");
        label.innerHTML = slider.value;

        // Add an event listener to the slider
        slider.addEventListener("input", function () {
            // Update the label with the current value
            label.innerHTML = slider.value;
            // Send a Jmol script command to change the van der Waals radius
            jmolScript("spacefill " + slider.value);
        });

        // Append the slider and the label to the document body
        document.body.appendChild(slider);
        document.body.appendChild(label);

    </script>
    <div id="control-panel">

        <!-- bond size dropdown -->
        <label for="bond-size-dropdown">Bond Size</label>
        <select id="bond-size-dropdown" onchange="changeBondSize(this.value)">
            <option value="0.1">0.1</option>
            <option value="0.2">0.2</option>
            <option value="0.3">0.3</option>
            <option value="0.4">0.4</option>
            <option value="0.5">0.5</option>
        </select>

    </div>

    <script>
        function changeBondSize(value) {
            jmolScript("wireframe " + value);
        }
    </script>

    
    <div id="control-panel">

        <!--spin switch-->
        <input type="button" value="Open Console" id="console-open" onclick="jmolScript('console;')">
        <input type="button" value="Get obj file" id="get-obj" onclick='jmolScript("write " + cid + ".obj;")'>
    </div>


</body>

</html>
