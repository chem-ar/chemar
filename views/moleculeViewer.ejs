<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.3/css/dataTables.bootstrap5.min.css">
    <title>ChemAR</title>

    <style>
        body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            color: white;
            background: #202020;
        }

        .content,
        .content-display,
        .content-jsmol {
            border: 2px solid #333;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .content-jsmol {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #control-panel,
        #control-panel2 {
            display: flex;
            justify-content: center;
            padding: 20px;
            align-items: center;
            border: 2px solid #333;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        input[type=button] {
            background-color: rgb(251, 251, 251);
            border-radius: 4px;
            border: 2px solid #333;
        }

        #backButton input[type=button] {
            background-color: #555555;
            color: white;
            font-size: 1.13rem;
            padding: 10px 20px;
        }

        #control-panel2 input[type=button] {
            background-color: #0071EB;
            color: white;
            font-size: 1.13rem;
            padding: 10px 20px;
        }

        #toggle-button {
            background-color: #097242;
            color: white;
            font-size: 1.13rem;
            padding: 10px 20px;
            border-radius: 4px;
            border: none;
        }
    </style>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css">

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script> 
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script>
        toastr.options = { escapeHtml: true, closeButton: true, progressBar: true };
    </script>
</head>

<body>
    <script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-database-compat.js"></script>
    <script src="/jmol-16.1.41/jsmol/JSmol.min.js"></script>
    <script src="/jmol-16.1.41/jsmol/js/Jmol2.js"></script>

    <!-- Back Button -->
    <div id="backButton">
        <a href="/molecules">
            <input type="button" value="Back to Molecules">
        </a>
    </div>

    <!-- Jmol Applet -->
    <div id="jmolApplet"></div>

    <script>
        // Extract CID from the current URL
        const currentURL = window.location.href;
        const urlParts = currentURL.split('/');
        const cid = urlParts[urlParts.length - 1];

        Jmol.Info.j2sPath = '/jmol-16.1.41/jsmol/j2s';
        Jmol.Info.serverURL = '/jmol-16.1.41/jsmol/php/jsmol.php';
        jmolInitialize('/jmol-16.1.41/jsmol', true);

        let extractedData;
        const url = `/molfiles/${cid}`;

        // Function to fetch data from the server
        function fetchData() {
            const xhr = new XMLHttpRequest();
            xhr.open('GET', url, false);
            xhr.send();

            if (xhr.status === 200) {
                extractedData = xhr.responseText.substring(0, xhr.responseText.indexOf("END")).trim();
                extractedData = '|' + extractedData.replace(/\n/g, '|').replace(/\r/g, '') + 'END|';
                return Promise.resolve(extractedData);
            } else {
                return Promise.reject(new Error("Something went wrong"));
            }
        }

        // Fetch data and render the Jmol applet
        fetchData()
            .then(data => {
                jmolSetAppletColor('0x202020');
                jmolApplet(['600', '600'], "set antialiasdisplay\;load data \"mydata\"" + data + "$$$$||end \"mydata\";spin on;background HOVER[NONE];", '0');
            })
            .catch(error => {
                console.error(error);
            });

        // Toggle Spin button
        jmolButton("spin @ {!_spinning}", "Toggle Spin", "toggle-button");

        // Slider for Van der Waals Radius
        var slider = document.createElement("input");
        var title = document.createElement("h5");
        title.innerHTML = "Van der Waals Radius";
        document.body.appendChild(title);
        slider.type = "range";
        slider.min = 0.2;
        slider.max = 2.0;
        slider.step = 0.1;
        slider.value = 0.3;

        var label = document.createElement("span");
        label.innerHTML = slider.value;

        slider.addEventListener("input", function () {
            label.innerHTML = slider.value;
            jmolScript("spacefill " + slider.value);
        });

        document.body.appendChild(slider);
        document.body.appendChild(label);
    </script>

    <!-- Bond Size Control Panel -->
    <script>
        var bondSizeSlider = document.createElement("input");
        //add title for the slider
        var bondSize = document.createElement("h5");
        bondSize.innerHTML = "Bond Size";
        document.body.appendChild(bondSize);
        bondSizeSlider.type = "range";
        bondSizeSlider.min = 0.1; // Minimum value for van der Waals radius
        bondSizeSlider.max = 0.5; // Maximum value for van der Waals radius
        bondSizeSlider.step = 0.1; // Step size for slider
        bondSizeSlider.value = 0.2; // Default value for slider

        // Create a label element to show the current value
        var currentValue = document.createElement("span");
        currentValue.innerHTML = bondSizeSlider.value;

        // Add an event listener to the slider
        bondSizeSlider.addEventListener("input", function () {
            // Update the label with the current value
            currentValue.innerHTML = bondSizeSlider.value;
            // Send a Jmol script command to change the van der Waals radius
            // jmolScript("spacefill " + slider1.value);
            changeBondSize(bondSizeSlider.value);
        });

        // Append the slider and the label to the document body
        document.body.appendChild(bondSizeSlider);
        document.body.appendChild(currentValue);

    </script>


    <script>
        // Function to change bond size
        function changeBondSize(value) {
            jmolScript("wireframe " + value);
        }
    </script>

    <!-- Additional Control Panel -->

    <div id="control-panel2">
        <input type="button" value="Get obj file" id="get-obj" onclick='jmolScript("write " + cid + ".obj;")'>
        <% if (isAdmin) { %>
            <input type="button" id="saveAsModelBtn"  value="Save Model" class="btn btn-primary">
        <% } %>
    </div>

    <!-- Modal Structure for Save Model -->
    <div id="saveModelModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h2>Save Model</h2>
            <form id="modelForm">
                <label for="modelName">Model Name:</label>
                <input type="text" id="modelName" name="modelName" required>
                
                <label for="modelDesc">Model Description:</label>
                <textarea id="modelDesc" name="modelDesc" required></textarea>
                
                <label for="fileName">File Name:</label>
                <input type="text" id="fileName" name="fileName" required>
                
                <button type="button" onclick="submitModelForm()">Save</button>
            </form>
        </div>
    </div>

    <style>
        /* General Modal Styling */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 9010;
            overflow: auto; 
        }

        /* Modal Content Styling */
        .modal-content {
            background-color: #ffffff;
            color: #333333;
            padding: 20px;
            border-radius: 5px;
            width: 90%; 
            max-width: 500px; 
            box-sizing: border-box;
            z-index: 9011;
            position: relative;
            margin: 5% auto; 
        }

        /* Close Button */
        .close {
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 24px;
            font-weight: bold;
            color: #333333;
            cursor: pointer;
        }

        .close:hover {
            color: #ff0000;
        }

        /* Input and Textarea Fields */
        input[type="text"],
        textarea {
            width: 100%;
            padding: 8px;
            margin-bottom: 15px;
            background-color: #ffffff;
            color: #333333;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        /* Save Button Styling */
        button {
            display: block;
            margin: 20px auto 0;
            padding: 10px 20px;
            background-color: #0071EB;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        button:hover {
            background-color: #005bb5;
        }
    </style>

    <script>
    
        document.getElementById('saveAsModelBtn').addEventListener('click', function () {
            document.getElementById("saveModelModal").style.display = "block";
        });

        // Close Modal Function
        function closeModal() {
            document.getElementById("saveModelModal").style.display = "none";
        }

        // Submit Form
        function submitModelForm() {
            const modelName = document.getElementById("modelName").value.trim();
            const modelDesc = document.getElementById("modelDesc").value.trim();
            const fileName = document.getElementById("fileName").value.trim();

            // Validate Inputs
            if (!modelName || !modelDesc || !fileName) {
                alert("All fields are required.");
                return;
            }

            // Encode the model name, description, and file name
            const encodedModelName = encodeURIComponent(modelName);
            const encodedModelDesc = encodeURIComponent(modelDesc);
            const encodedFileName = encodeURIComponent(fileName);

            

            // Call JmolScript to save model
            jmolScript(`write ${window.location.origin}/addmodel/quickSaveModel/${encodedModelName}/${encodedModelDesc}/${encodedFileName}.obj`);
            
            // Poll model status
            pollModelStatus(modelName);
        }

        // check if the model has been saved or not
        function pollModelStatus(normalModelName) {
            let notified = false; // Flag to ensure notification shows only once

            // check periodically to see if model was saved, if so check for success or error messages
            const interval = setInterval(async () => {
                try {
                    const response = await fetch(`${window.location.origin}/addmodel/modelStatus/${normalModelName}`);
                    const data = await response.json();
        
                    // If there's an error and we haven't shown the error notification
                    if (data.isSaved && data.isSaved.error && !notified) {
                        notified = true;
                        clearInterval(interval);
                        toastr.error(data.isSaved.error + ", Try Changing the Name or Description", 'Error', {
                            timeOut: 3000,
                            positionClass: 'toast-top-right',
                            progressBar: true
                        });
                    } 
                    // If the model is successfully saved and we haven't shown the success notification
                    else if (data.isSaved && data.isSaved.success && !notified) {
                        notified = true;

                        // Close the modal
                        closeModal();

                        clearInterval(interval);
                        toastr.success('Model Added Successfully', 'Success', {
                            timeOut: 1500,
                            positionClass: 'toast-top-right',
                            progressBar: true
                        });
                        setTimeout(() => {
                            window.location.href = "/molecules";
                        }, 1500);
                    }
                } catch (error) {
                    console.error('Error polling model status:', error);
                }
            }, 1); // Poll every 0.01 seconds
        }
    </script>
    
</body>
</html>
<%- include('partials/footer') %>