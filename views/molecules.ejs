<%- include('partials/header') %>

<!-- ADMIN NAVBAR CHECK -->
<% if (isAdmin) { %>
    <%- include('partials/navbarAdmin') %>
<% } %>

<% if (!isAdmin) { %>
    <%- include('partials/navbar') %>
<% } %>

<script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

<div class="container mb-4">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white bg-dark">
            <h1 class="display-4 fw-bold">Molecule Catalog</h1>

            <!-- ADMIN CHECK -->
            <% if (isAdmin) { %>
                <!-- Include the partial for adding a molecule (if admin) -->
                <%- include('partials/addMolecule') %>
            <% } %>

            <p></p>
            
            <!-- Molecule Table -->
            <table id="molTable" class="table table-striped text-white" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Formula</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody id="moleculeTableBody">
                    <!-- Molecules will be added dynamically here -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Molecule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this molecule?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>

<script>
    let dataTable;

    fetch("/catalog/molfileCatalog.json")
        .then((response) => response.json())
        .then((data) => {
            dataTable = data;
            // Iterates through the json file
            for (let item in data) {
                var id = item.replace(".mol", "");
                // Check if the molecule ID exists before trying to update the name and formula
                if (document.getElementById("Name"+id) != null) {
                    var molName = document.getElementById("Name"+id);
                    var molFormula = document.getElementById("Formula"+id); 
                    molName.innerHTML = data[item].name;
                    molFormula.innerHTML = data[item].formula;
                }
            }
            // Initialize DataTable
            $('#molTable').DataTable();
        });

        const moleculesRef = firebase.database().ref("molecules");

        moleculesRef.once("value")
            .then(snapshot => {
                dataTable = snapshot.val();
                initializeDataTable();
            })
            .catch(error => {
                console.error("Error fetching data from Firebase:", error);
            });
    });

    function initializeDataTable() {
        const table = $('#molTable').DataTable({
            data: convertDataToArray(),
            columns: [
                {
                    data: null,
                    render: function (data, type, row) {
                        return '<a href="/moleculeViewer/' + data.id + '">' + data.commonName + '</a>';
                    }
                },
                { data: 'formula' },
                {
                    data: null,
                    render: function (data, type, row) {
                        let buttonsHtml = '';

                        // Check if user is an admin
                        if (<%= isAdmin %>) {
                            // Admin-specific buttons
                            buttonsHtml += '<button class="btn btn-outline-warning">Edit</button>' +
                                '<button class="btn btn-outline-danger" onclick="showDeleteModal(\'' + data.id + '\')">Delete</button>';
                        }

                        // Common buttons
                        buttonsHtml += '<button class="btn btn-light" onclick="handlePreview(\'' + data.id + '\')">Preview</button>' +
                            '<button class="btn btn-light" onclick="handleShare(\'' + data.id + '\')">Share</button>';

                        return buttonsHtml;
                    },
                    orderable: false
                }
            ],
            pageLength: 10,
            searching: true,
            ordering: true,
        });
    }

    function convertDataToArray() {
        const dataArray = [];
        for (let id in dataTable) {
            const molecule = dataTable[id];
            molecule.id = id; // Add the ID to the data for later reference
            dataArray.push(molecule);
        }
        return dataArray;
    }

    $(document).ready(function () {
        $('#molTable').DataTable({
            scrollY: false,
            scrollX: true,
            scrollCollapse: true,
            paging: true
        });

        deleteModal.show();
    }

    function deleteMolecule(moleculeId) {
        const moleculesRef = firebase.database().ref("molecules");
        moleculesRef.child(moleculeId).remove()
            .then(() => {
                console.log("Molecule deleted successfully");
                // Show success message
                alert("Molecule deleted successfully");
            })
            .catch(error => {
                console.error("Error deleting molecule:", error);
                // Show error message
                alert("Error deleting molecule");
            });
    }

    var share = document.getElementsByClassName("share");

    Array.from(share).forEach(function(element) {
        element.addEventListener("click", function(){
            let itemNumber = element.id.replace("shareBtn", "");
            qrcode.makeCode(window.location.href + "/viewer/" + itemNumber); 
        })
    });
</script>


    function handleShare(moleculeId) {
        // Implement functionality for share button
    }
</script>

