<%- include('partials/header') %>

<!-- ADMIN NAVBAR CHECK -->
<% if (isAdmin) { %>
    <%- include('partials/navbarAdmin') %>
<% } %>

<% if (!isAdmin) { %>
    <%- include('partials/navbar') %>
<% } %>

<script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

<div class="container mb-4">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white bg-dark">
            <h1 class="display-4 fw-bold">Molecule Catalog</h1>

            <!-- ADMIN CHECK -->
            <% if (isAdmin) { %>
                <!-- Include the partial for adding a molecule (if admin) -->
                <%- include('partials/addMolecule') %>
            <% } %>

            <p></p>
            
            <!-- Molecule Table -->
            <table id="molTable" class="table table-striped text-white" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Formula</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody id="moleculeTableBody">
                    <!-- Molecules will be added dynamically here -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Molecule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this molecule?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Firebase Scripts -->
<script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-database-compat.js"></script>

<!-- Main Script -->
<script>
    let dataTable;

    document.addEventListener("DOMContentLoaded", function () {
        // Initialize Firebase with your credentials 
        const firebaseConfig = { databaseURL: "https://chemar-5845a-default-rtdb.firebaseio.com/", };

        firebase.initializeApp(firebaseConfig);

        const moleculesRef = firebase.database().ref("molecules");

        moleculesRef.once("value")
            .then(snapshot => {
                dataTable = snapshot.val();
                initializeDataTable();
            })
            .catch(error => {
                console.error("Error fetching data from Firebase:", error);
            });
    });

    function initializeDataTable() {
        const table = $('#molTable').DataTable({
            data: convertDataToArray(),
            columns: [
                {
                    data: null,
                    render: function (data, type, row) {
                        return '<a href="/moleculeViewer/' + data.id + '">' + data.commonName + '</a>';
                    }
                },
                { data: 'formula' },
                {
                    data: null,
                    render: function (data, type, row) {
                        let buttonsHtml = '';

                        // Check if user is an admin
                        if (<%= isAdmin %>) {
                            // Admin-specific buttons
                            buttonsHtml += '<button class="btn btn-outline-warning">Edit</button>' +
                                '<button class="btn btn-outline-danger" onclick="showDeleteModal(\'' + data.id + '\')">Delete</button>';
                        }

                        // Common buttons
                        buttonsHtml += '<button class="btn btn-light" onclick="handlePreview(\'' + data.id + '\')">Preview</button>' +
                            '<button class="btn btn-light" onclick="handleShare(\'' + data.id + '\')">Share</button>';

                        return buttonsHtml;
                    },
                    orderable: false
                }
            ],
            pageLength: 10,
            searching: true,
            ordering: true,
        });
    }

    function convertDataToArray() {
        const dataArray = [];
        for (let id in dataTable) {
            const molecule = dataTable[id];
            molecule.id = id; // Add the ID to the data for later reference
            dataArray.push(molecule);
        }
        return dataArray;
    }

    function showDeleteModal(moleculeId) {
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

        confirmDeleteBtn.addEventListener('click', () => {
            deleteModal.hide();
            deleteMolecule(moleculeId);
        });

        deleteModal.show();
    }

    function deleteMolecule(moleculeId) {
        const moleculesRef = firebase.database().ref("molecules");
        moleculesRef.child(moleculeId).remove()
            .then(() => {
                console.log("Molecule deleted successfully");
                // Show success message
                alert("Molecule deleted successfully");
            })
            .catch(error => {
                console.error("Error deleting molecule:", error);
                // Show error message
                alert("Error deleting molecule");
            });
    }

    // Additional functions for handling preview and share buttons
    function handlePreview(moleculeId) {
        // Implement functionality for preview button
    }

    function handleShare(moleculeId) {
        // Implement functionality for share button
    }
</script>

<%- include('partials/footer') %>