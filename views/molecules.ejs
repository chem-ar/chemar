<%- include('partials/header') %>
<!--ADMIN NAVBAR CHECK-->
<% if (isMainAdmin) { %>
    <%- include('partials/navbarMainAdmin') %>
  <% } else if (isAdmin) { %>
    <%- include('partials/navbarAdmin') %>
  <% } %>
<% if (!isAdmin){%>
    <%- include('partials/navbar') %>
<%}%>
<script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

<div class="container mb-4">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white bg-dark">
            <h1 class="display-4 fw-bold">Molecule Catalog</h1>

            <!--ADMIN CHECK-->
            <% if (isAdmin){%>
                <%- include('partials/addMolecule') %>
            <%}%>
            
            <p></p>
            <table id="molTable" class="table table-striped text-white" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Formula</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody>

                    <!-- this is to sort stuff in formulas by ascii/alphanumericlaly-->
                    <% 
                    // Get list of molecules
                    let formulas = list.map(item => item.formula);
                    formulas.sort(); // javascript sort uses ASCII values to sort
                    
                    // map sorted Formula values back to original list
                    let sortedList = formulas.map(formula => list.find(item => item.formula === formula));

                    // Render sorted list
                    for (let item of sortedList) {
                    %>
                    <tr>
                        <td>
                            <a class="text-white" id="Name<%=item.file %>" href="/moleculeViewer/<%=item.file%>"><%=item.name%></a>
                        </td>
                        <td id="Formula<%=item.file %>" class="text-white"><%=item.formula%></td>
                        <td class>
                            <div class = "d-grid gap-2">
                                <button id="<%= "shareBtn" + item.file %>" type="button" class="share btn btn-light" data-bs-toggle="modal" data-bs-target="#shareModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-share" viewBox="0 0 16 16">
                                        <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5zm-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/>
                                    </svg> Share
                                </button>
                            <!--ADMIN CHECK-->
                            <% if (isAdmin){%>
                                <button type="button" id="edit<%=item.file %>" onclick="" class="btn btn-outline-warning editMoleculeBtn" data-bs-toggle="modal" data-bs-target="#editModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                    </svg> Edit
                                </button>

                                <button type="button" class="btn btn-outline-danger deleteMoleculeBtn" data-bs-toggle="modal" data-bs-target="#deleteModal" data-file="<%= item.file %>">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                                    </svg> Delete
                                </button>
                            <%}%>
                            </div>
                        </td>
                    </tr>
                    <%}%>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this molecule?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger" data-bs-dismiss="modal">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="canvasModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
               
            </div>
            <div class="modal-body">
                <div class="">
                    <div id="qrcode" class="bg-white py-4" align="center"></div>
                    <script type="text/javascript">
                    var qrcode = new QRCode(document.getElementById("qrcode"), "http://jindo.dev.naver.com/collie");
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>
  
<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="canvasModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="canvasModalLabel">Name</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-12 text-start text-white bg-dark">
                    <form class="" action="/" method="PUT" id="editMolForm">
                        <div class="row ">
                            <div class="col-12 col-sm-12 col-md-12">
                                <h4 class="mb-1 mt-2">Molecule Name:</h4>
                                <input type="text" class="form-control" id="moleculeNameEdit" name="name" placeholder="Molecule Name" required>
                                <h4 class="mb-1 mt-2">Formula:</h4>
                                <input type="text" class="form-control" id="formulaEdit" name="formula" placeholder="Formula" required>
                                <h4 class="mb-1 mt-2">Description:</h4>
                                <input type="text" class="form-control" id="moleculeDescriptionEdit" name="description" placeholder="Description" required>
                                <button id="editSubmitBtn" class="btn btn-success form-control my-2">Submit</button>
                            </div>
                            <div class="col-12 col-sm-3">
                                <textarea class="form-control d-none" name="preview" id="preview"></textarea>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-content .modal-body {
        color: white;
    }
</style>

<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">

<script type="module">
    $(document).ready(function() {
    $('#deleteModal').appendTo("body");
    $('#shareModal').appendTo("body");
    $('#editModal').appendTo("body");
});

    let dataTable;

    fetch("/catalog/molfileCatalog.json")
        .then((response) => response.json())
        .then((data) => {
            dataTable = data;
            // Iterates through the json file
            for (let item in data) {
                var id = item.replace(".mol", "");
                // Check if the molecule ID exists before trying to update the name and formula
                if (document.getElementById("Name"+id) != null) {
                    var molName = document.getElementById("Name"+id);
                    var molFormula = document.getElementById("Formula"+id); 
                    molName.innerHTML = data[item].name;
                    molFormula.innerHTML = data[item].formula;
                }
            }
            if(!$.fn.DataTable.isDataTable('#molTable')){
                // Initialize DataTable
                $('#molTable').DataTable();
            }
        })
        .catch(err => toastr.error(err.message));

    // Adding edit button functionality.
var editBtnArray = document.getElementsByClassName("editMoleculeBtn");

var moleculeNameEditInput = document.getElementById("moleculeNameEdit");
var formulaEditInput = document.getElementById("formulaEdit");
var moleculeDescriptionEditInput = document.getElementById("moleculeDescriptionEdit");

// Event listener for edit submit button
var editSubmitBtn = document.getElementById("editSubmitBtn");
editSubmitBtn.addEventListener('click', e => {
    e.preventDefault();
    // Get the molecule ID from the submit button's data-id attribute
    var id = editSubmitBtn.getAttribute("data-id"); // Get the molecule ID from data-id attribute

    let updatedMolecule = {
        name: moleculeNameEditInput.value,
        formula: formulaEditInput.value,
        description: moleculeDescriptionEditInput.value
    };

    fetch(`/molecules/editMolecule/${id}`, {
        method: "PUT",
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify(updatedMolecule)
    })
    .then(response => {
        if (response.ok) {
            location.reload(); // Reload the page to reflect changes
        } else {
            throw new Error(
                `Failed to update molecule. Server returned status ${response.status}`
            );
        }
    })
    .catch(error => {
        toastr.error(error.message);
    });
});

// Loop through each edit button and attach click event listener
Array.from(editBtnArray).forEach(btn => {
    var id = btn.id.replace("edit", ""); // Adjusted ID generation
    btn.addEventListener('click', () => {
        // Check if the id exists in the dataTable object
        if (dataTable.hasOwnProperty(id)) {
            let currentMolecule = dataTable[id];

            moleculeNameEditInput.value = currentMolecule.name;
            formulaEditInput.value = currentMolecule.formula;
            moleculeDescriptionEditInput.value = currentMolecule.description;

            // Set the data-id attribute of the submit button to the molecule ID
            editSubmitBtn.setAttribute("data-id", id);
        } else {
            console.error(`Molecule with ID ${id} not found in the dataTable.`);
        }
    });
});

    // Preview the .mol file content when selected
    function onReceiptsSelected() {
        const files = fileName.files;
        if (files.length > 0) {
            const reader = new FileReader();
            reader.onload = (e) => {
            document.getElementById("preview").value += e.target.result;
            };
            reader.readAsText(files[0]);
        }
    }

    var share = document.getElementsByClassName("share");

    Array.from(share).forEach(function(element) {
        element.addEventListener("click", function(){
            let itemNumber = element.id.replace("shareBtn", "");
            qrcode.makeCode(window.location.href + "/viewer/" + itemNumber); 
        })

    });

// delete molecule
var deleteModalBody = document.querySelector("#deleteModal .modal-body"); // Get delete modal body element

// Add event listener to delete buttons
var deleteButtons = document.getElementsByClassName("deleteMoleculeBtn");

// Loop through each delete button and add click event listener
Array.from(deleteButtons).forEach(function(button) {
    button.addEventListener("click", function() {
        var file = this.getAttribute("data-file");
        var moleculeName = this.closest("tr").querySelector("td:first-child").textContent; // Get molecule name from the closest table row

        // Set the text content of the modal body to include the molecule's name
        deleteModalBody.textContent = `Are you sure you want to delete ${moleculeName}?`;
        deleteModalBody.setAttribute("data-file-to-delete", file);
    });
});

var confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
confirmDeleteBtn.addEventListener("click", function() {
    const file = deleteModalBody.getAttribute("data-file-to-delete");
    fetch(`/molecules/deleteMolecule/${file}`, { // Change the route to match your server-side route
        method: "POST" // Change method to POST
    })
    .then(response => {
        if (response.ok) {
            // if successful, reload the page
            location.reload(); // Reload the page to reflect changes
        } else {
            throw new Error(
                `Failed to delete molecule. Server returned status ${response.status}`
            );
        }
    })
    .catch(error => {
        toastr.error(error.message);
    });
});

</script>

<%- include('partials/footer') %>