<%- include('partials/header') %>

<!-- ADMIN NAVBAR CHECK -->
<% if (isAdmin){%>
    <%- include('partials/navbarAdmin') %>
<%}%>

<% if (!isAdmin){%>
    <%- include('partials/navbar') %>
<%}%>

<script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>

<div class="container mb-4">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white bg-dark">
            <h1 class="display-4 fw-bold">Molecule Catalog</h1>

            <!-- ADMIN CHECK -->
            <% if (isAdmin){%>
                <%- include('partials/addMolecule') %>
            <%}%>

            <p></p>
            <table id="molTable" class="table table-striped text-white" style="width:100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Formula</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody id="moleculeTableBody">
                    <!-- Molecules will be added dynamically here -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Molecule</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this molecule?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.6.8/firebase-database-compat.js"></script>

<script>
    let dataTable;

    document.addEventListener("DOMContentLoaded", function () {
        // Initialize Firebase with your credentials 
        const firebaseConfig = { databaseURL: "https://chemar-5845a-default-rtdb.firebaseio.com/", };

        firebase.initializeApp(firebaseConfig);

        const moleculesRef = firebase.database().ref("molecules");

        moleculesRef.once("value")
            .then(snapshot => {
                dataTable = snapshot.val();
                populateTable();
            })
            .catch(error => {
                console.error("Error fetching data from Firebase:", error);
            });
    });

    function populateTable() {
        const tableBody = document.getElementById("moleculeTableBody");

        for (let id in dataTable) {
            const row = tableBody.insertRow();
            const cellName = row.insertCell(0);
            const cellFormula = row.insertCell(1);
            const cellOptions = row.insertCell(2);

            cellName.innerHTML = dataTable[id].commonName;
            cellFormula.innerHTML = dataTable[id].formula;

            // Check if user is authenticated
            <% if (isAdmin){%>
    const editBtn = document.createElement("button");
    editBtn.className = "btn btn-outline-warning";
    editBtn.innerHTML = "Edit";
    editBtn.addEventListener('click', () => {
        // Handle edit button click 
    });

    const deleteBtn = document.createElement("button");
    deleteBtn.className = "btn btn-outline-danger";
    deleteBtn.innerHTML = "Delete";
    deleteBtn.addEventListener('click', () => {
        showDeleteModal(id);
    });

    cellOptions.appendChild(editBtn);
    cellOptions.appendChild(deleteBtn);
<%}%>


            const previewBtn = document.createElement("button");
            previewBtn.className = "btn btn-light";
            previewBtn.innerHTML = "Preview";
            previewBtn.addEventListener('click', () => {
                // Handle preview button click 
            });

            const shareBtn = document.createElement("button");
            shareBtn.className = "btn btn-light";
            shareBtn.innerHTML = "Share";
            shareBtn.addEventListener('click', () => {
                // Handle share button click 
            });

            cellOptions.appendChild(previewBtn);
            cellOptions.appendChild(shareBtn);
        }
    }

    function showDeleteModal(moleculeId) {
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

        confirmDeleteBtn.addEventListener('click', () => {
            deleteModal.hide();
            deleteMolecule(moleculeId);
        });

        deleteModal.show();
    }

    function deleteMolecule(moleculeId) {
        const moleculesRef = firebase.database().ref("molecules");
        moleculesRef.child(moleculeId).remove()
            .then(() => {
                console.log("Molecule deleted successfully");
                // Optionally, you can update the table or perform other actions after deletion
                // Show success message
                alert("Molecule deleted successfully");
            })
            .catch(error => {
                console.error("Error deleting molecule:", error);
                // Show error message
                alert("Error deleting molecule");
            });
    }
</script>

