        function getMolecule(URL){
            fetch(URL + "?record_type=3d")
                .then(response => response.text())
                .then(data => {
                    if(data.includes("PUGREST.NotFound")){
                        fetch(URL + "?record_type=2d")
                            .then(response => response.text())
                            .then(data => {
                                if(data.includes("PUGREST.NotFound")){
                                    console.log("2D File Not Found");
                                }else{
                                    drawMolecule(data);
                                }
                            });
                    }else{
                        drawMolecule(data);
                    }
                });
            }

        function searchPUBCHEM(name){
            if(name === ""){
                searchResults.innerHTML = `<div class="text-warning pt-2 px-2">Please enter a search term</div>`;
            }
            else{
                const URL = `https://pubchem.ncbi.nlm.nih.gov/rest/pug/compound/name/${name}/property/IUPACName,MolecularFormula,Title/JSON`;
                 searchResults.innerHTML = `<div class="pt-2 px-2">Searching</div>`;
                 if(name){
                    fetch(URL)
                        .then(response => response.json())
                        .then(data => displaySearchResults(data, null))
                        .catch(error => console.log(error))
                }
            }
        }

        function displaySearchResults(data, error){
            console.log(data);
            if(data.hasOwnProperty('Fault')){
