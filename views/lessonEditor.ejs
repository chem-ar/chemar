                        <div class="offcanvas-body">
                            <div class = "row">
                                <h4>Lesson Sheet</h4>
                                <div class = "col-12">
                                    <button type="button" class="btn btn-outline-light" data-bs-toggle="collapse" href="#fileMenu" role="button" aria-expanded="false" aria-controls="fileMenu">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-fill" viewBox="0 0 16 16">
                                            <path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm5.5 1.5v2a1 1 0 0 0 1 1h2l-3-3z"/>
                                          </svg>
                                        Load .png File
                                    </button>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 mt-2">
                                  <div class="collapse multi-collapse" id="fileMenu">
                                    <div class="mb-3">
                                        <input class="form-control form-control-lg" type="file" id="fileInput" accept=".png">
                                      </div>
                                  </div>
                                </div>
                            </div>
                            <hr>
                            <div class = "row">
                                <h4>Tracking Marker Position</h4>
                                <p>(offset from the bottom left of page)</p>
                                <div class = "col-12">
                                    <div class = "row">
                                        <div class = "col-4">
                                            <label for="marker-x" class="form-label">Offset X</label>
                                            <input type="number" class="form-control" id="markerXSlider" min="0" max="11.0" step=".01" value="0" oninput="markerXInput.value = markerXSlider.value">
                                        </div>
                                    </div>

                                    <div class = "row">
                                        <div class = "col-12">
                                            <input type="range" class="form-range" id="markerXInput" min="0" max="11.0"  step=".01" value="0" oninput="markerXSlider.value = markerXInput.value" >
                                        </div>
                                    </div>

                                    <div class = "row">
                                        <div class = "col-4">
                                            <label for="marker-y" class="form-label">Offset Y</label>
                                            <input type="number" class="form-control"  id="markerYSlider"  min="0" max="8.5" step=".01" value="0" oninput="markerYInput.value = markerYSlider.value" >
                                        </div>
                                    </div>

                                    <div class = "row">
                                        <div class = "col-12">
                                            <input type="range" class="form-range" id="markerYInput"  min="0" max="8.5" step=".01" value="0" oninput="markerYSlider.value = markerYInput.value" >
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr>
                            <div class = "row">
                                <h4>Add Molecule</h4>
                                <div class = "col-12">
                                    <button type="button" class="btn btn-outline-light" data-bs-toggle="collapse">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-fill" viewBox="0 0 16 16">
                                            <path d="M4 0h5.293A1 1 0 0 1 10 .293L13.707 4a1 1 0 0 1 .293.707V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm5.5 1.5v2a1 1 0 0 0 1 1h2l-3-3z"/>
                                          </svg>
                                        Load from Pubchem
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

