<%- include('partials/header') %>
<%- include('partials/navbar') %>
<script type="module">
  var form = document.getElementById("passwordForm");
  form.addEventListener('submit', login);

  function login(e) {
    e.preventDefault();
    var password = document.getElementById("passwordInput").value;
    let email = document.getElementById("emailInput").value;
    fetch(`/session/`, {
        method: "Post",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({password: password, email: email})
      })
      .then(async response => {
        const body = await response.json().catch(_error => ({}));

        if (response.status === 401 && body.error) {
          throw new Error(body.error);
        } else if (!response.ok) {
          throw new Error(`Server returned status code ${response.status}`);
        }
        
        window.location = "/";
      })
      .catch(error => {
        toastr.error(error.message, "Login failed");
      });
  }

  var forgotPassBtn = document.getElementByID("forgotPassBtn");
  forgotPassBtn.addEventListener("click", sendForgotPasswordPage());

  function sendForgotPasswordPage(){

  }
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN" crossorigin="anonymous"></script>

<section class="vh-100 gradient-custom">
  <div class="container py-5 h-100">
    <div class="row d-flex justify-content-center align-items-center h-100">
      <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <div class="card bg-secondary text-white" style="border-radius: 1rem">
          <div class="card-body p-5 text-center">
            <div class="mb-md-5 mt-md-4 pb-5">
              <br><br><br>
              <h1 class="fw-bold mb-2">Admin Login</h1>
              <h4 class="mb-5">Please enter admin password:</h4>

              <!--Form-->
              <form id="passwordForm">
                <div class="form-outline form-white mb-4">
                  <input type="email" id="emailInput" class="form-control form-control-lg" name="email" placeholder="Email:">
                  <br>

                  <input type="password" id="passwordInput" class="form-control form-control-lg" name="password" placeholder="Password:">
                  <br>

                  <!--Red Incorrect Password Message-->
                  <label class="form-label" id="passerrormsg" style="color: rgb(176, 44, 44); font-weight: bold;" hidden>
                    <h5>Incorrect password. Please try again.</h5>
                  </label>
                </div>

                <!--Login Button-->
                <button class="btn btn-outline-light btn-lg px-5" type="submit">
                  Login
                </button>
                <br>
                <br>
                <!--Forgot Password Button-->
                <a id = "forgotPassBtn" class = "btn btn-outline-light btn-lg px-5" style = "color: red" type = "button" href = "/forgotPasswordPage">Forgot Password</a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>