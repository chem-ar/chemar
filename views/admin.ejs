    margin-left: 10px;
  }

  .main-background-color h4 {
    font-size: 1.2rem;
    margin-left: 10px;
  }

  .form-control {
    font-size: 1rem;
    padding: 10px;
    
  }

  ul.text-bright-white {
    font-size: 1rem;
  }

  small.text-bright-white {
    font-size: 1rem;
  }


  .form-outline {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 10px;
}
