<%- include('partials/header') %>
<% if (isowner) { %>
  <%- include('partials/navbarowner') %>
<% } else if (isAdmin) { %>
  <%- include('partials/navbarAdmin') %>
<% } %>
<% if (!isAdmin) { %>
<%- include('partials/navbar') %>
<% } %>

<link rel="stylesheet" type="text/css" href="styles/views-css/admin.css">
<div class="p-3 mb-2 text-white main-background-color">
  <h2 class="display-5 fw-bold">Admin Tools</h2>
  <h4 class="admin-page mt-3">Change Password</h4>
  <div class="form-container">
    <form id="changePasswordForm" onsubmit="changePassword(event)" action="" method="post">
      <div class="form-outline">
        <input
          required
          type="password"
          id="oldPassword"
          class="form-control"
          name="oldPassword"
          placeholder="Old Password:"
        >
      </div>    
      <div class="form-outline">
        <h4 class="admin-page mt-3" style="margin-left: 0;">New Password</h4>   
        <small class="text-bright-white">Password Requirements:</small>
        <ul class="text-bright-white">
          <li>At least 7 characters long</li>
          <li>At least one uppercase letter</li>
          <li>At least one lowercase letter</li>
          <li>At least one number</li>
          <li>At least one symbol (@!$%*?&)</li>
        </ul>
        <input
          required
          type="password"
          id="newPassword"
          class="form-control"
          name="newPassword"
          placeholder="New Password:"
          onkeyup="checkPasswordStrength()"
        >
      </div>
      <div id="passwordFeedback"></div>

      <div class="form-outline">
        <input
          required
          type="password"
          id="confirmNewPassword"
          class="form-control"
          name="confirmNewPassword"
          placeholder="Confirm New Password:"
          onkeyup="checkPassword()"
        >
        <div id="matchedPassword"></div>
      </div>      
      <input type="submit" id="changePasswordBtn" class="btn btn-primary" value="Change Password">
    </form>
  </div>
</div>
    <script>
      const confirmedNewPasswordInput = document.getElementById('confirmNewPassword');
      const newPasswordInput = document.getElementById('newPassword');
      const passwordFeedback = document.getElementById('passwordFeedback');

      //event listener for user input
      function changePassword(e) {
        e.preventDefault();
        const form = document.getElementById('changePasswordForm');
        var oldPassword = document.getElementById('oldPassword').value;
        var confirmedNewPassword = confirmedNewPasswordInput.value;
        var newPassword = newPasswordInput.value;

        let body = {
          password: oldPassword,
          newPassword: newPassword
        }
        if (newPassword == confirmedNewPassword) {
          fetch(`/session/changepassword`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify(body)
            })
            .then(async response => {
              const body = await response.json().catch(_error => ({}));

              if (response.status === 401 && body.error) {
                throw new Error(body.error);
              } else if (!response.ok) {
                throw new Error(`Server returned status code ${response.status}`);
              }

              toastr.success("Password changed successfully");
              form.reset();
              confirmedNewPasswordInput.style.backgroundColor = '';
              newPasswordInput.style.backgroundColor = '';
              passwordFeedback.textContent = '';
            })
            .catch(error => {
              console.error("Error:", error);
              toastr.error(error.message, "Failed to change Password");
            });
        }
      }
      // Check if passwords match
      function checkPassword(e) {
        var newPassword = newPasswordInput.value;
        var oldPassword = document.getElementById('oldPassword').value;
        var confirmedNewPassword = confirmedNewPasswordInput.value;

        //passwords match
        matchedPassword.innerHTML = "";
        if (newPassword == confirmedNewPassword) {
          confirmedNewPasswordInput.style.backgroundColor = '#b3ffb3';
          matchedPassword.textContent = "";
          matchedPassword.style.opacity = "0";
        } 
        //new and confirmed passwords do not match
        else {
          confirmedNewPasswordInput.style.backgroundColor = '#ff9980';
        
          matchedPassword.textContent = "Passwords do not match";
          matchedPassword.style.backgroundColor = "#ff9980";
          matchedPassword.style.color = "#990f02";
          matchedPassword.style.padding = "5px";
          matchedPassword.style.border = "1px solid #990f02";
          matchedPassword.style.borderRadius = "4px";
          matchedPassword.style.display = "inline-block";
          matchedPassword.style.opacity = "0.9";
        }
      }
      //check if the password meets all requirements
      function checkPasswordStrength() {
        var newPassword = newPasswordInput.value;
        let strength = true;
        //reset old feedback
        passwordFeedback.innerHTML = "";

        checkPassword(newPassword);

        try {
          validatePassword(newPassword);
        }
        //display all unmet password requirements to the user
        catch(error) {          
          const missingRequirements = error.message;

          missingRequirements.forEach(message => {
            const div = document.createElement('div');
            const p = document.createElement('p');
            p.textContent = message;
            //style each error message
            p.style.backgroundColor = "#ff9980";
            p.style.color = "#990f02";
            p.style.padding = "5px";
            p.style.border = "1px solid #990f02";
            p.style.borderRadius = "4px";
            p.style.display = "inline-block";
            p.style.opacity = "0.9";

            div.appendChild(p);
            passwordFeedback.appendChild(div);
          });
          strength = false;
        }

        //users password meets all requirements "strong"
        if (strength) {
          const div = document.createElement('div');
          const p = document.createElement('p');
          newPasswordInput.style.backgroundColor = '#b3ffb3';
          
          p.textContent = 'Strong Password';
          p.style.color = '#18392b';
          p.style.backgroundColor = "#b3ffb3";
          p.style.padding = "5px";
          p.style.border = "1px solid #18392b";
          p.style.borderRadius = "4px";
          p.style.display = "inline-block";
          p.style.opacity = "0.9";

          div.appendChild(p);
          passwordFeedback.appendChild(div);
        } else {
          newPasswordInput.style.backgroundColor = '#ff9980';
        }
      }

      //validate all new password requirements
      function validatePassword(password) {
        const regex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@#$%^&*!])[A-Za-z\d@#$%^&*!]{7,}$/;

        //check for specific missing password requirements
        const passwordErrors = [];

        if(!(/[A-Z]+/).test(password)) { 
          passwordErrors.push("Password must contain at least one uppercase letter (A-Z)");
        }
        if(!(/[a-z]+/).test(password)) { 
          passwordErrors.push("Password must contain at least one lowercase letter (a-z)");
        }
        if(!(/\d+/).test(password)) { 
          passwordErrors.push("Password must contain at least one number (0-9)");
        }
        if(!(/[@#$%^&*!]+/).test(password)) { 
          passwordErrors.push("Password must contain at least one special character (@#$%^&*!)");
        }
        if(!(/^[\s\S]{7,}$/).test(password)) { 
          passwordErrors.push("Password must be at least seven characters");
        }
        //if all requirements have been met after user input changes, empty the error array
        if(regex.test(password)) {
          passwordErrors.length = 0;
        }

        if(passwordErrors.length > 0) {
          throw { message: passwordErrors};
        }
      }
    </script>
  <footer>
    <%- include('partials/footer') %>
  </footer>
</body>

</html>