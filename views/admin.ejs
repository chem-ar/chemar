<%- include('partials/header') %>
<% if (isAdmin) { %>
  <%- include('partials/navbarowner') %>
<% } else if (isInstructor) { %>
  <%- include('partials/navbarAdmin') %>
<% } else { %>
  <%- include('partials/navbar') %>
<% } %>


<div class="p-3 mb-2 text-white main-background-color">
  <h2 class="display-5 fw-bold">Admin Tools</h2>
  <h4 class="admin-page mt-3">Change Password</h4>
  <div class="form-container">
    <form id="changePasswordForm" onsubmit="changePassword(event)" action="" method="post">
      <div class="form-outline">
        <input
          required
          type="password"
          id="oldPassword"
          class="form-control"
          name="oldPassword"
          placeholder="Old Password:"
        >
      </div>
      <div class="form-outline">
        <input
          required
          type="password"
          id="newPassword"
          class="form-control"
          name="newPassword"
          placeholder="New Password:"
          onkeyup="checkPasswordStrength()"
        >
        <small class="text-bright-white">Password Requirements:</small>
        <ul class="text-bright-white">
          <li>At least 7 characters long</li>
          <li>At least one uppercase letter</li>
          <li>At least one lowercase letter</li>
          <li>At least one number</li>
          <li>At least one symbol (@!$%*?&)</li>
        </ul>
      </div>
      <div class="form-outline">
        <input
          required
          type="password"
          id="confirmNewPassword"
          class="form-control"
          name="confirmNewPassword"
          placeholder="Confirm New Password:"
          onkeyup="checkPassword()"
        >
      </div>
      <div id="passwordFeedback" class="text-white"></div>
      <input type="submit" id="changePasswordBtn" class="btn btn-primary" value="Change Password">
    </form>
  </div>
</div>
    <style>
     
    



body {
  font-family: Arial, sans-serif;
  background-color: #181A1F;
  color: white;
  min-height: 100%;
  margin: 0;
}

