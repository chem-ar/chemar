  font-size: 2rem;
  text-align: left;
  margin-left: 40px;
}

.main-background-color h4 {
  font-size: 1.2rem;
  text-align: left;
  margin-bottom: 20px;
  margin-left: 40px;
  font-weight: normal;
}

