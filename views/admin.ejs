  width: 500px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 10px;
}

.form-control {
  width: 100%;
  padding: 10px;
  font-size: 1rem;
  border-radius: 5px;
  border: 1px solid #ccc;
  background-color: white;
  color: black;
}

.btn.btn-primary {
  height: 50px;
  font-size: 1.38rem;
  background-color: black;
  border-color: rgb(255, 255, 255);
  border-width: 2px;
}

.btn.btn-primary:hover {
  background-color: white;
  color: black;
