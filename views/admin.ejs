<%- include('partials/header') %>
<% if (isAdmin) { %>
<%- include('partials/navbarAdmin') %>
<% } %>
<% if (!isAdmin) { %>
<%- include('partials/navbar') %>
<% } %>

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://cdn.datatables.net/1.13.3/css/jquery.dataTables.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js" integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="home.css">
  <title> <%=title%> </title>
</head>

<body>
  <div class="p-3 mb-2 bg-dark text-white">
    <h2 class="display-5 fw-bold" style="text-align: center">
      Admin Tools
    </h2>
    <h4 class="display-7 mt-3" style="text-align: center">
      Change Password
    </h4>
    <div class="px-5">
      <form id="changePasswordForm" onsubmit="changePassword(event)" action="" method="post">
        <div align="center">
          <div class="form-outline form-white mb-4">
            <input type="password" id="oldPassword" class="form-control-lg" size="50" name="oldPassword" placeholder="Old Password:">
          </div>

          <div class="form-outline form-white mb-4">
            <input type="password" id="newPassword" class="form-control-lg" size="50" name="newPassword" placeholder="New Password:">
          </div>

          <div class="form-outline form-white mb-4">
            <input type="password" id="confirmNewPassword" class="form-control-lg" size="50" name="confirmNewPassword" placeholder="Confirm New Password:" onkeyup="checkPassword()">
          </div>

          <input type="submit" class="btn btn-primary" value="Change Password">

        </div>
      </form>
    </div>

    <script>
      function changePassword(e) {
        e.preventDefault();
        var oldPassword = document.getElementById('oldPassword').value;
        var confirmedNewPassword = document.getElementById('confirmNewPassword').value;
        var newPassword = document.getElementById('newPassword').value;

        let body = {
          password: oldPassword,
          newPassword: newPassword
        }
        if (newPassword == confirmedNewPassword) {
          fetch(`/session/forgot`, {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify(body)
            })
            .then(response => {
              if (response.ok) {
                console.log("Password Changed");
                location.reload(); // Reload the page to reflect changes
              } else {
                console.error("Failed to change Password");
              }
            })
            .catch(error => {
              console.error("Error:", error);
            });
        }
      }

      // Check if passwords match
      function checkPassword(e) {
        var newPassword = document.getElementById('newPassword').value;
        var oldPassword = document.getElementById('oldPassword').value;
        var confirmedNewPassword = document.getElementById('confirmNewPassword').value;
        var newPasswordInput = document.getElementById('newPassword');
        var confirmedNewPasswordInput = document.getElementById('confirmNewPassword');

        if (newPassword == confirmedNewPassword) {

          confirmedNewPasswordInput.style.backgroundColor = '#b3ffb3';
          newPasswordInput.style.backgroundColor = '#b3ffb3';


        } else {
          confirmedNewPasswordInput.style.backgroundColor = '#ff9980';
          newPasswordInput.style.backgroundColor = '#ff9980';
        }
      }
    </script>

    <h4 class="display-7 mt-5" style="text-align: center">
      Site Analytics
    </h4>
    <p style="text-align:center">Spot for site visitor information.</p>
  </div>
  <footer>
    <%- include('partials/footer') %>
  </footer>

</body>

</html>