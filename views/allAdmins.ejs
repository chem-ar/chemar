<%- include('partials/header') %>
<!--ADMIN NAVBAR CHECK-->
<% if (isOwner){%>
<%- include('partials/navbarowner') %>
<%}%>
<script src="https://cdn.rawgit.com/davidshimjs/qrcodejs/gh-pages/qrcode.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<div class="container mb-4 main-background-color">
    <div class="row content">
        <div class="col-12 pt-4 text-start text-white">
            <h1 class="display-4 fw-bold">Admin Catalog</h1>
            <div class="d-flex gap-2 pb-4">
                <a href="https://accounts.google.com/o/oauth2/v2/auth?client_id=875656222736-ip7hujo32jhjskno15s9pdi95jom97ig.apps.googleusercontent.com&redirect_uri=https://dalchemar.azurewebsites.net/refreshToken&scope=https://mail.google.com&response_type=code&prompt=consent&access_type=offline" type="button" class="btn btn-info">Renew Google Cloud Token</a>
                <!-- IF you are testing it on local host Change the href's redirect_uri = https://localhost:4000/refreshToken -->
            </div>    
            <table id="adminTable" class="table table-striped text-white" style="width:100%">
                <thead>
                <tr>
                    <th class="model-table-header">Email</th>
                    <th class="model-table-header">Role </th>
                    <th class="options-column model-table-header">Delete</th>
                </tr>
                </thead>
                <tbody id="table-body">
                </tbody>
            </table>
            <div class="text-end mt-3">
                <button id="saveChangesBtn" class="btn btn-success">Save Changes</button>
            </div> 
        </div>
        <br>
              
        <div class="container mt-5">
            <div class="card p-4 shadow-sm">
                <h2 class="text-center mb-4">Backup Information</h2>
                <h4>Download Backup Files</h4>
                <button id="downloadBackup" class="btn btn-primary">Download Backup</button>
                <script>
                    document.getElementById('downloadBackup').addEventListener('click', () => {
                        window.location.href = '/alladmin/download-backup';
                    });
                    </script>
                <br>
                <h4>Restore Backup</h4>
                <form id="backupUploadForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <input type="file" id="backupFile" name="backupZip" accept=".zip" class="form-control" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Upload & Restore</button>
                </form>
            </div>
        </div>
        

        <script>
            document.getElementById('backupUploadForm').addEventListener('submit', async (event) => {
                event.preventDefault();
            
                const fileInput = document.getElementById('backupFile');
                const formData = new FormData();
                formData.append('backupZip', fileInput.files[0]);
            
                try {
                    const response = await fetch('/alladmin/upload-backup', {
                        method: 'POST',
                        body: formData
                    });
            
                    const result = await response.json();
                    if (response.ok) {
                        toastr.success(result.message, 'Success', {
                            timeOut: 3000,
                            positionClass: 'toast-top-right',
                            progressBar: true
                        });
                    } else {
                        toastr.error(result.error || 'Failed to restore backup', 'Error', {
                            timeOut: 3000,
                            positionClass: 'toast-top-right',
                            progressBar: true
                        });
                    }
                } catch (error) {
                    console.error('Upload error:', error);
                    toastr.error('Failed to upload the backup file', 'Error');
                }
            });
            </script>

    </div>
</div>
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.11.5/js/dataTables.bootstrap5.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/dataTables.bootstrap5.min.css">


<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
      <div class="modal-content bg-dark">
          <div class="modal-header">
              <h5 class="modal-title text-white" id="deleteModalLabel">Confirm Delete</h5>
              <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
              Are you sure you want to delete this Admin?
          </div>
          <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
              <button type="button" id="confirmDeleteBtn" class="btn btn-danger" data-bs-dismiss="modal">Delete</button>
          </div>
      </div>
  </div>
</div>


<style>
    .modal-content .modal-body {
        color: white;
    }
    .compact-role-select {
  max-width: 160px;
  padding: 2px 6px;
  font-size: 0.9rem;
  height: 30px;
  border-radius: 4px;
}

</style>

<script>
    $(document).ready(function () {
        $('#deleteModal, #editRoleModal').appendTo("body");

        // Initialize the DataTable
        dataTable = $('#adminTable').DataTable({
            ordering: true
        });
        
        fetchAdmins();
    });

    let dataTable;

    // Fetch the admin data from the server
    function fetchAdmins() {
        fetch("/alladmin/alladminsearch")
            .then((res) => {
                if (!res.ok) {
                    throw new Error(`HTTP error Status: ${res.status}`);
                }
                return res.json();
            })
            .then((adminData) => {
                dataTable.clear();

                // Populate the table with the fetched admin data
                for (const admin of adminData) {
                    populateTable(admin);
                }

                dataTable.draw();
            })
            .catch((error) => toastr.error(error.message, "Unable to fetch data"));
    }
    
    // Delete button functionality
    function handleDeleteClick(event) {
        const btn = event.currentTarget;
        const email = btn.id;

        document.getElementById('confirmDeleteBtn').onclick = function () {
            fetch(`/alladmin/delete`, {
                method: "DELETE",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email })
            }).then(async response => {
                let result = await response.json();
                if (response.ok) {
                    toastr.success(result.message, "Admin deleted successfully");

                    // Refresh the admin list
                    fetchAdmins();
                } else {
                    let error = result.error;
                    console.error("Failed to delete admin:", error);
                    toastr.error(error || "Failed to delete admin", "Error");
                }
        })
        .catch(error => {
            console.error("Error:", error);
            toastr.error(error.message, "Failed to delete Admin");
        });
    };
}

// Populate the table with data
function populateTable(adminData, index) {

    // Add new row to the DataTable
    const newRow = dataTable.row.add([
        adminData.email,
        `<select class="form-select compact-role-select role-select" data-email="${adminData.email}">
        <option value="admin" ${adminData.role === 'admin' ? 'selected' : ''}>Admin</option>
        <option value="instructor" ${adminData.role === 'instructor' ? 'selected' : ''}>Instructor</option>
        <option value="student" ${adminData.role === 'student' ? 'selected' : ''}>Student</option>
        </select>`,
        `<button type="button" class="btn deleteModelBtn" style="background-color: #CC0000; color: white;" 
            id="${adminData.email}" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash"></i> Delete
        </button>`
    ]).draw().node();

        // Ensure the new row is now part of the DOM before querying
        $(newRow).find('.deleteModelBtn').on('click', handleDeleteClick);

    }
    document.addEventListener('DOMContentLoaded', async () => {
        try {
            const response = await fetch('/alladmin/last-backup');
            const result = await response.json();
    
            if (result.lastBackupDate) {
                const lastBackupDate = new Date(result.lastBackupDate);
                const today = new Date();
                const differenceInDays = Math.floor((today - lastBackupDate) / (1000 * 60 * 60 * 24));
    
                toastr.info(`It has been ${differenceInDays} days since the last backup.`, 'Backup Status');
            } else {
                toastr.info('No backup history available. Please create your first backup.', 'Backup Status');
            }
        } catch (error) {
            console.error('Error fetching last backup date:', error);
            toastr.error('Failed to retrieve last backup date', 'Error');
        }
    });

    document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('saveChangesBtn').addEventListener('click', async () => {
        const updates = [];

        document.querySelectorAll('.role-select').forEach(select => {
            const email = select.getAttribute('data-email');
            const role = select.value;
            updates.push({ email, role });
        });
        //needs to be edited or changed to support database updates
        try {
            const response = await fetch('/alladmin/updateRoles', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ updates })
            });

            const result = await response.json();

            if (response.ok) {
                toastr.success(result.message || "Roles updated successfully!");
                fetchAdmins(); // refresh table
            } else {
                toastr.error(result.error || "Failed to update roles");
            }
        } catch (err) {
            console.error(err);
            toastr.error("An unexpected error occurred");
        }
    });
});

    
</script>

<%- include('partials/footer') %>
